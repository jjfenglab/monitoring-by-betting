    ])

@nest.add_target_with_env(localenv)
def embed_pools(env, outdir, c):
    sources = [
        f"data/{c['dataset']}/p0_pool.csv",
        f"data/{c['dataset']}/p1_pool.csv",
    ]
    targets = [
        path_join(outdir, "embeddings.npz"),
        path_join(outdir, "mapping.csv"),
        path_join(outdir, "embed.log"),
    ]
    cmd = [
        "python", "src/assemble_ai_scribe.py",
        "--text-mode",  c["text_mode"],
        "--draft-col",  DRAFT_COL,
        "--final-col",  FINAL_COL,
        "--embed-model", EMBED_MODEL,
        "--sae-frac",       SAE_FRAC,
        "--sae-split-seed", SAE_SPLIT_SEED,
        "--p0-pool-path", "${SOURCES[0]}",
        "--p1-pool-path", "${SOURCES[1]}",
        "--embeddings-path", "${TARGETS[0]}",
        "--mapping-path",    "${TARGETS[1]}",
        "--log",              "${TARGETS[2]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


def _is_sae(c):
    return c["concept_learner_type"].startswith("sae")


if any(t.startswith("sae") for t in CONCEPT_LEARNER_TYPES):
    @nest.add_target_with_env(localenv)
    def extract_sae_side(env, outdir, c):
        sources = [c["embed_pools"][0], c["embed_pools"][1]]
        targets = [
            path_join(outdir, "sae_train_embeddings.npz"),
            path_join(outdir, "extract_sae_side.log"),
        ]
        cmd = [
            "python", "src/extract_split_embeddings.py",
            "--embeddings-path", "${SOURCES[0]}",
            "--mapping-path",    "${SOURCES[1]}",
            "--split-label",     "p0_sae",
            "--out",              "${TARGETS[0]}",
            "--log",               "${TARGETS[1]}",
        ]
        return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))

    @nest.add_target_with_env(localenv)
    def train_sae(env, outdir, c):
        sources = [c["extract_sae_side"][0]]
        targets = [
            path_join(outdir, "sae", f"SAE_M={SAE_M}_K={SAE_K}.pt"),
            path_join(outdir, "sae", "sae_settings.json"),
        ]
        cmd = [
            "python", "src/train_sae.py",
            "--embeddings-path", "${SOURCES[0]}",
            "--checkpoint-dir",  path_join("exp_ai_scribe", outdir, "sae"),
            "--M", SAE_M,
            "--K", SAE_K,
        ]
        return env.Command(targets, sources, _run_cmd(cmd))


@nest.add_target_with_env(localenv)
def write_text_direction(env, outdir, c):
    nodes = {}
    for variant, descriptions_json in CTM_DIRECTION_FILES.items():
        targets = [
            path_join(outdir, f"directions_{variant}.npz"),
            path_join(outdir, f"directions_{variant}.log"),
        ]
        cmd = [
            "python", "src/write_text_direction.py",
            "--descriptions-json", "${SOURCES[0]}",
            "--embed-model",       EMBED_MODEL,
            "--out",               "${TARGETS[0]}",
            "--log",               "${TARGETS[1]}",
        ]
        if EMBED_LOCAL_ONLY:
            cmd.append("--local-files-only")
        nodes[variant] = env.Command(targets, [descriptions_json], _run_cmd(cmd, use_slurm=False))
    return nodes

@nest.add_target_with_env(localenv)
def write_pool_direction(env, outdir, c):
    sources = [c["embed_pools"][0], c["embed_pools"][1]]
    targets = [
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.npz"),
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.log"),
    ]
    cmd = [
        "python", "src/write_pool_direction.py",
        "--embeddings-path", "${SOURCES[0]}",
        "--mapping-csv",     "${SOURCES[1]}",
        "--label",           f"{LABEL}_pool",
        "--out",             "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))

