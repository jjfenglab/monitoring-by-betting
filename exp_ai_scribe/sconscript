@nest.add_target_with_env(localenv)
def plot(env, outdir, c):
    sources = [c["aggregate_all"][0], c["aggregate_all_ctm"][0]]
    targets = [
        path_join(outdir, "arl_edd.png"),
        path_join(outdir, "calibration_arl.png"),
        path_join(outdir, "plot.log"),
    ]
    cmd = [
        "python", "src/plot_cebab.py",
        "--csv",     "${SOURCES[0]}",
        "--ctm-csv", "${SOURCES[1]}",
        "--n-burn-in", N_BURN_IN,
        "--out-nominal", "${TARGETS[0]}",
        "--out-calibration", "${TARGETS[1]}",
        "--n-pre",   N_PRE,
        "--threshold-min", THRESHOLD_MIN,
        "--threshold-max", THRESHOLD_MAX_PLOT,
        "--threshold-min-null", THRESHOLD_MIN,
        "--threshold-max-null", THRESHOLD_MAX_PLOT_NULL,
        "--log",     "${TARGETS[2]}",
        "--baseline", "family=CTM",
        "--hue-cols",        *PLOT_HUE_COLS,
    ]
    if PLOT_FACET_ROW:
        cmd += ["--facet-row", PLOT_FACET_ROW]
    if PLOT_FACET_COL:
        cmd += ["--facet-col", PLOT_FACET_COL]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))

