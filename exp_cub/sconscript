    "ctm_variant",
    lambda c: list(_ctm_direction_files(c["config"])) + [CTM_POOL_VARIANT]
    if c["ctm_scorer"] == "guided"
    else ["none"],
    label_func=lambda c: f"var_{c}",
)


@nest.add_target_with_env(localenv)
def create_ctm_config(env, outdir, c):
    """Write CTMConfig JSON for this scorer, and for guided its direction arm."""
    targets = [path_join(outdir, "ctm_config.json")]
    sources = []
    cmd = [
        "python",
        "src/write_ctm_config.py",
        "--out",
        "${TARGETS[0]}",
        "--scorer",
        c["ctm_scorer"],
        "--n-reference",
        CTM_N_REFERENCE,
        "--jump-rates",
        CTM_JUMP_RATES,
        "--alpha",
        ALPHA,
        "--n-burn-in",
        N_BURN_IN,
    ]
    if c["ctm_scorer"] == "guided":
        if c["ctm_variant"] == CTM_POOL_VARIANT:
            sources = [c["write_pool_direction"][0]]
        else:
            sources = [c["write_text_direction"][c["ctm_variant"]][0]]
        cmd += [
            "--direction-path",
            "${SOURCES[0]}",
            "--variant",
            c["ctm_variant"],
