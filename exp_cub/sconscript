@nest.add_target_with_env(localenv)
def ctm_cell_summary(env, outdir, c):
    """Threshold sweep for one scorer, once per epsilon."""
    skip_null = N_NULL_SEEDS == 0
    result_pkls = c["ctm_result_pkls"]
    seed_class = _seed_class(None)
    nodes = []
    for eps in POST_P1_FRACTIONS:
        eps_result_pkls = [
            pkl
            for pkl in result_pkls
            if "null_" in pkl or f"shift_{eps}_seed_" in pkl
        ]
        metadata_list = [m for m in c["metadata_list"] if f"post_p1_{eps}/" in m]
        sources = eps_result_pkls + [c["create_ctm_config"][0]]
        shift_res_globs = []
        null_res_glob = None
        for pkl_path in eps_result_pkls:
            if "null_0" in pkl_path:
                null_res_glob = path_join(
                    "exp_cub", pkl_path.replace("null_0", f"null_{seed_class}")
                )
            elif "seed_0" in pkl_path:
                shift_res_globs.append(
                    path_join("exp_cub", pkl_path.replace("seed_0", f"seed_{seed_class}"))
                )
        null_dat_glob = path_join(
            "exp_cub",
            OUTDIR,
            c["config"],
            "null",
            f"seed_{seed_class}",
            "stream_metadata.json",
        )
        shift_dat_globs = []
        for metadata_path in metadata_list:
            if "seed_0" in metadata_path:
                shift_dat_globs.append(
                    path_join("exp_cub", metadata_path.replace("seed_0", f"seed_{seed_class}"))
                )
        targets = [
            path_join(outdir, f"eps_{eps}", "summary.csv"),
            path_join(outdir, f"eps_{eps}", "aggregate.log"),
        ]
        n_result_pkls = len(eps_result_pkls)
        cmd = [
            "python",
            "src/aggregate_ctm_cell.py",
            "--shift-res-globs",
            " ".join([f'"{gl}"' for gl in shift_res_globs]),
            "--shift-dat-globs",
            " ".join([f'"{gl}"' for gl in shift_dat_globs]),
            "--label",
            c["config"],
            "--threshold-min",
            THRESHOLD_MIN,
            "--threshold-max",
            THRESHOLD_MAX,
            "--n-thresholds",
            N_THRESHOLDS,
            "--n-bootstrap",
            N_BOOTSTRAP,
            "--config-json",
            f"${{SOURCES[{n_result_pkls}]}}",
            "--out-csv",
            "${TARGETS[0]}",
            "--log",
            "${TARGETS[1]}",
        ]
        if skip_null:
            cmd += ["--skip-null"]
        else:
            cmd += [
                "--null-res-glob",
                f'"{null_res_glob}"',
                "--null-dat-glob",
                f'"{null_dat_glob}"',
            ]
        c["ctm_cell_summaries"].setdefault(eps, []).append(targets[0])
        nodes.append(env.Command(targets, sources, _run_cmd(cmd, use_slurm=False)))
    return nodes


nest.pop("ctm_variant")
nest.pop("ctm_scorer")


@nest.add_target_with_env(localenv)
def aggregate_all_ctm(env, outdir, c):
    cmd = [
        "python",
        "src/aggregate_results.py",
        "--input-csv",
        "${SOURCES}",
        "--out-csv",
        "${TARGETS[0]}",
    ]
    nodes = {}
    for eps in POST_P1_FRACTIONS:
        targets = [path_join(outdir, f"eps_{eps}", "all_ctm_summary.csv")]
        nodes[eps] = env.Command(
            targets, c["ctm_cell_summaries"][eps], _run_cmd(cmd, use_slurm=False)
        )
    return nodes


@nest.add_target_with_env(localenv)
def aggregate_all(env, outdir, c):
    cmd = [
        "python",
        "src/aggregate_results.py",
        "--input-csv",
        "${SOURCES}",
        "--out-csv",
        "${TARGETS[0]}",
    ]
    nodes = {}
    for eps in POST_P1_FRACTIONS:
        targets = [path_join(outdir, f"eps_{eps}", "all_summary.csv")]
        nodes[eps] = env.Command(
            targets, c["cell_summaries"][eps], _run_cmd(cmd, use_slurm=False)
        )
    return nodes


@nest.add_target_with_env(localenv)
def final_plot(env, outdir, c):
    """One set of figures per config and epsilon"""
    commands = []
    for eps in POST_P1_FRACTIONS:
        sources = [c["aggregate_all"][eps][0], c["aggregate_all_ctm"][eps][0]]
        targets = [
            path_join(outdir, f"eps_{eps}", "arl_edd.png"),
            path_join(outdir, f"eps_{eps}", "calibration_arl.png"),
            path_join(outdir, f"eps_{eps}", "plot.log"),
        ]
        cmd = [
            "python",
            "src/plot_cebab.py",
            "--csv",
            "${SOURCES[0]}",
            "--ctm-csv",
            "${SOURCES[1]}",
            "--n-burn-in",
            N_BURN_IN,
            "--out-nominal",
            "${TARGETS[0]}",
            "--out-calibration",
            "${TARGETS[1]}",
            "--n-pre",
            N_PRE,
            "--threshold-min",
            THRESHOLD_MIN,
            "--threshold-max",
            THRESHOLD_MAX_PLOT,
            "--threshold-min-null",
            THRESHOLD_MIN,
            "--threshold-max-null",
            THRESHOLD_MAX_PLOT_NULL,
            "--hue-cols",
            *PLOT_HUE_COLS,
            "--title-prefix",
            f'"{c["config"]} eps={eps}"',
            "--log",
            "${TARGETS[2]}",
            "--baseline", "family=CTM",
        ]
        if PLOT_FACET_COL is not None:
            cmd += ["--facet-col", PLOT_FACET_COL]
        if PLOT_FACET_COL_ORDER is not None:
            cmd += ["--facet-col-order", *PLOT_FACET_COL_ORDER]
        commands.append(
            env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))
        )
    return commands
