"""

Semi-synthetic monitoring experiment on CUB-200 bird images.

The injected shift is an ATTRIBUTE TILT: one population of photos (the seabirds)
supplies both pools, p0 uniformly and p1 with probability proportional to
sigma(beta0 + beta . a(x)) over chosen binary CUB attributes, so the changepoint
is a shift in attribute prevalence (white crowns become common),
not a switch of species. post_p1_fraction is the shift
strength epsilon. Observations are image paths, embeddings are CLIP, and the LLM
concept learner attaches the images to its LLM calls (--is-image).

What corresponds to what in exp_cebab:
  shift_aspect -> config (TILT_CONFIGS: the attributes carrying the tilt)
  BETA_DICT -> TILT_BETA / TILT_BETA0 (one tilt strength for all configs)
  data/population.* + assemble_cebab.py -> data/CUB_200_2011 + assemble_cub_tilt.py
  pools under _output/<shift_aspect>/ -> pools under data/pools/seabirds/<config>/
  oracle_random_pool = [shift_aspect] -> oracle_random_pool = the config's true_concepts.json columns
                                   (tilted attributes + beta = 0)
  POST_P1_FRACTIONS = [1.0] -> [0.5, 1.0], summarized and plotted one epsilon at a time

What to edit:
  TILT_CONFIGS           uncomment a config to run it (with its DISTRACTOR_ATTRIBUTES entry)
  CONCEPT_LEARNER_TYPES  uncomment "bertopic_llm" to run the LLM-billed arm. SEED_CAPS
                         holds it to 10 shift streams per epsilon and no null streams.
  N_NULL_SEEDS, N_SEEDS  40 is the paper grid; 4 is a smoke run on the same stream seeds
Run with `scons exp_cub` locally or `scons exp_cub --slurm -j100` on the cluster.

Stages (per config):
  0.  assemble_pools (guarded)  -> data/pools/seabirds/CONFIG/{p0,p1}_pool.csv,
                                   embeddings.npz, mapping.csv, true_concepts.json
  1a. create_null_data_stream   -> _output/CONFIG/null/seed_S/stream.csv
  2a. create_shift_data_stream  -> _output/CONFIG/post_p1_E/seed_S/stream.csv
  2b. run_monitor (per cell x stream) -> _output/.../result.pkl
  3.  cell_summary (per cell x epsilon) -> .../eps_E/summary.csv
  4.  aggregate_all (per epsilon)       -> _output/CONFIG/eps_E/all_summary.csv
  5.  final_plot (per epsilon)          -> _output/CONFIG/eps_E/*.png
"""

import os
from os.path import dirname, exists
from os.path import join as path_join

from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import Import

Import("env")
localenv = env.Clone()

USE_SLURM = env["use_slurm"]

# On clusters whose login and compute fleets use different HTTP proxies, srun's
# default --export=ALL can propagate the wrong proxy to compute nodes. Set
# COMPUTE_PROXY in the environment (e.g. `http://proxy.compute:3128`) to force a
# specific outbound proxy on srun steps; leave it unset otherwise.
COMPUTE_PROXY = os.environ.get("COMPUTE_PROXY", "")
PROXY_ENV = (
    " ".join(
        f"{v}={COMPUTE_PROXY}"
        for v in ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy")
    )
    if COMPUTE_PROXY
    else ""
)


def _run_cmd(cmd_parts, n_cpus=2, mem="5G", use_slurm=USE_SLURM):
    full = " ".join(str(x) for x in cmd_parts)
    if use_slurm:
        # --nodes/--ntasks are explicit so steps launched inside an salloc don't
        # inherit SLURM_NTASKS and request ntasks * n_cpus processors.
        full = (
            f"srun --nodes=1 --ntasks=1 --cpus-per-task={n_cpus} "
            f"--mem-per-cpu={mem} --time=72:00:00 env {PROXY_ENV} {full}"
        )
    return full

TORCH_MEM = "8G"

OUTDIR = "_output"

# --- LLM infrastructure: prompts, model, shared cache ---
PROMPT_KEYPHRASE_FILE = "exp_cub/prompts/keyphrases.txt"
PROMPT_BERTOPIC_ITER_FILE = "exp_cub/prompts/proposer_bertopic_iter.txt"
PROMPT_BERTOPIC_INIT_FILE = "exp_cub/prompts/proposer_bertopic_init.txt"
PROMPT_ANNOTATOR_FILE = "exp_cub/prompts/annotator.txt"
# Same files, sconscript-relative: extra SCons sources for LLM-arm runs, which
# read them at runtime through the config's repo-root-relative paths above.
PROMPT_SOURCES = [
    "prompts/keyphrases.txt",
    "prompts/proposer_bertopic_iter.txt",
    "prompts/proposer_bertopic_init.txt",
    "prompts/annotator.txt",
]
LLM_MODELS = ["azure/gpt-4.1-mini-2025-04-14"]
LLM_BATCH_SIZE = 100  # prompts per keyphrase/annotator LLM batch (= parallel requests)

# --- data artifacts (paths relative to this dir unless noted) ---
CUB_DIR = "exp_cub/data"  # project-root-relative: a python argument
CLASSES_TXT = "data/CUB_200_2011/classes.txt"
POOLS_DIR = "data/pools"
EMBED_MODEL = "clip-ViT-B-32"
# Resolve CLIP from the local HF cache only (compute nodes without Hub access).
EMBED_LOCAL_ONLY = False

# --- pool-assembly parameters (see src/assemble_cub_tilt.py) ---
# The population both pools draw from: every class whose genus (last word of the CUB
# class name) is listed. 1945 images, large enough that N_P0 + N_P1 draws are
# repeat-free and that a tilt reweights species mildly instead of collapsing onto one.
POPULATION = "seabirds"
POPULATION_GENERA = [
    "Gull",
    "Tern",
    "Albatross",
    "Jaeger",
    "Puffin",
    "Cormorant",
    "Fulmar",
    "Kittiwake",
    "Auklet",
    "Merganser",
    "Pelican",
]
TILT_BETA = 6.0
TILT_BETA0 = -4.0
POOL_SEED = 0
# config name -> attributes carrying the tilt. All are eligible under the selection rule
# of src/select_cub_tilt.py (report: tilt_selection/seabirds.json).
TILT_CONFIGS = {
    "bill_yellow": ["has_bill_color::yellow"],
    "crown_white": ["has_crown_color::white"],
}
# config name -> attributes recorded at beta = 0. oracle_random_pool is given these alongside
# the tilted attributes, so the subset scan has uninformative concepts to reject.
DISTRACTORS = [
    "has_belly_color::white",
    "has_wing_color::white",
    "has_size::medium_(9_-_16_in)",
    "has_bill_shape::hooked_seabird",
    "has_primary_color::brown",
    "has_underparts_color::black",
    "has_shape::duck-like",
]
DISTRACTOR_ATTRIBUTES = {
    "bill_yellow": DISTRACTORS,
    "crown_white": DISTRACTORS,
}

# --- SAE parameters ---
SAE_M = 32
SAE_K = 3
# sae_online: the same checkpoint, warm-started every SAE_REFIT_EVERY SCL updates.
SAE_REFIT_EVERY = 1
SAE_REFIT_EPOCHS = 5

# Configs whose tilted attribute is the CONSENSUS label (image label AND species
# majority; assemble_cub_tilt.py --consensus). CUB annotates attributes per image and
# the labels wander within a species, so a tilt on the raw label plants annotator noise
# that no image-reading monitor can see. Crown white has the most consistent image
# labels of the eligible attributes (agreement with the species majority 0.87).
CONSENSUS_CONFIGS = {"crown_white"}


def population_classes():
    """1-based CUB class ids of POPULATION_GENERA ("099.Ovenbird" has no underscore)."""
    with open(CLASSES_TXT) as f:
        rows = [line.split() for line in f]
    return sorted(
        int(class_id)
        for class_id, name in rows
        if name.split(".", 1)[1].split("_")[-1] in POPULATION_GENERA
    )


def pool_path(config, name):
    """Sconscript-relative path of one pool artifact."""
    return path_join(POOLS_DIR, POPULATION, config, name)


def _oracle_concept_cols(config):
    """oracle_random_pool's pool columns: the tilted attributes, then the beta = 0 distractors."""
    return TILT_CONFIGS[config] + DISTRACTOR_ATTRIBUTES[config]


# --- data-generating parameters ---
N_NULL_SEEDS = 0
N_SEEDS = 2
# Caps the LLM-billed arm's streams; the caps index into the shared seed_dict, so the
# LLM-free arms still run every seed. null: 0 drops the LLM arm's null runs, leaving
# it without an empirical ARL0 (see cell_summary / --skip-null). cell_summary turns a
# cap into a [0-N] glob class, so caps stay <= 10.
SEED_CAPS = {
    "bertopic_llm": {"shift": 10, "null": 0},
}

# Shift stream S is seeded SHIFT_SEED_OFFSET + S, keeping it disjoint from null stream S.
SHIFT_SEED_OFFSET = 10000
PRE_P1_FRACTION = 0.0
POST_P1_FRACTIONS = [
    # 0.5,
    1.0,
]  # epsilon: fraction of post-change traffic drawn from the tilted p1 pool

# Stream generation lengths
N_PRE = 50
N_POST = 300
# thresholds where the arms separate
SHIFT_LEN = N_PRE + N_POST
NULL_LEN = SHIFT_LEN
K_CALIB = 30  # calibration-pool size M (realistic-deployment scale)
# Pool sizes follow from the draws each stream makes. The slack is what makes the null
# seeds independent samples: at exactly K_CALIB + NULL_LEN every seed would draw the
# WHOLE p0 pool and differ only in ordering.
POOL_SLACK = 200
N_P0 = K_CALIB + NULL_LEN + POOL_SLACK
N_P1 = N_POST  # the whole post segment at epsilon = 1

# Caps on how many stream observations the monitor runs over.
MAX_STEPS_NULL = NULL_LEN
MAX_STEPS_SHIFT = SHIFT_LEN

# --- monitoring parameters ---
N_BURN_IN = 30
CANDIDATE_STEP = 1
LAM = 0.5
ALPHA = 0.05
N_BOOTSTRAP = 1000
# Per-step annotated matrix CSVs for the first 10 streams of each cell. Off here
SAVE_MATRIX_SNAPSHOTS = False
# Run lengths are reported net of burn-in, so the pre-change window is N_PRE - N_BURN_IN
# process steps; a nominal ARL0 below that would false-alarm before the change on average.
THRESHOLD_MIN = N_PRE - N_BURN_IN + 1
THRESHOLD_MAX = MAX_STEPS_SHIFT - N_BURN_IN
N_THRESHOLDS = int((THRESHOLD_MAX - THRESHOLD_MIN) / 5 + 1)
# Online cost cap: a run halts once M_t reaches this, saving LLM calls on the LLM
# arm once detection is already certain. Kept >= THRESHOLD_MAX so the sweep above is
# never truncated -- aggregate_cell.py drops any threshold above it.
MAX_M_STATISTIC = SHIFT_LEN
MIN_BLOCK = 10

CHANGEPOINT_LEARNER_NAMES = [
    "mean_shift",
]
CHANGEPOINT_FEATURE_DICT = {
    "identity": ["embedding"],
    "mock": ["concept"],
    "sae": ["concept"],
    "sae_online": ["concept"],
    "oracle_random_pool": ["concept"],
    "bertopic_llm": ["concept"],
}

# --- concept learners ---
CONCEPT_LEARNER_TYPES = [
    "identity",
    "sae",
    "bertopic_llm",
]


def _is_sae(c):
    """Both SAE arms (frozen and online) share the checkpoint."""
    return c["concept_learner_type"].startswith("sae")

LLM_LEARNER_TYPES = ["bertopic_llm"]
CONCEPT_TYPES = LLM_LEARNER_TYPES + ["oracle_random_pool"]
N_INIT_CONCEPTS = 4
N_NEW_CONCEPTS_PER_UPDATE = 2
LLM_N_NEW_CONCEPTS = 2  # bertopic_llm and mock
MOCK_NOISE_RATE = 0.3  # informative concept: P(1 | post) = 0.7, P(1 | pre) = 0.3

# bertopic_llm: number of BERTopic topics (can exceed N_INIT_CONCEPTS)
N_BERTOPIC_TOPICS = 25

# Only subset_scan variant is used - full annotation
SCL_VARIANT = "subset_scan"

CLASSIFIERS = [
    "logistic",
]
# <= this many classifier inputs -> unpenalized fit; above -> ridge. identity feeds
# 512 CLIP dims (ridge); concept arms feed a handful (unpenalized).
MAX_UNPENALIZED_DIM = 10

# --- LLM-arm cost controls ---
LLM_CP_LEARNERS = ("mean_shift",)

# --- CTM baseline (conformal test martingale) parameters ---
CTM_SCORERS = [
    "cosine_centroid",
    "guided",
]
CTM_N_REFERENCE = K_CALIB // 2
CTM_JUMP_RATES = "0.01"
CTM_POOL_VARIANT = "embedding-oracle"


def _ctm_direction_files(config):
    """Return CTM direction file paths for the given config."""
    return {
        "text-oracle": f"prompts/drift_directions_oracle_{config}.json",
        "text-unrelated": f"prompts/drift_directions_unrelated.json",
    }


# --- plotting ---
THRESHOLD_MAX_PLOT = MAX_STEPS_SHIFT - N_BURN_IN
THRESHOLD_MAX_PLOT_NULL = MAX_STEPS_NULL - N_BURN_IN
PLOT_FACET_COL = None
PLOT_FACET_COL_ORDER = None
PLOT_HUE_COLS = [
    "family",
    "cp_feature_source",
    "concept_learner_type",
    "oracle_variant",
    "sae_variant",
    "variant",
    "search_all_sizes",
]


def _seed_class(cap):
    """Glob class for a stream index: every seed, or the arm's first `cap` seeds."""
    return "*" if cap is None else f"[0-{cap - 1}]"


def _capped_run_seeds(c):
    """seed_dict keys for this cell, honoring the arm's per-kind seed caps."""
    caps = SEED_CAPS.get(c["concept_learner_type"])
    if caps is None:
        return list(c["seed_dict"])
    keep = []
    for key in c["seed_dict"]:
        kind = "null" if key.startswith("null_") else "shift"
        if int(key.rsplit("_", 1)[1]) < caps[kind]:
            keep.append(key)
    return keep


def _monitor_seed(run_seed_key):
    """Monitor RNG seed for a stream: null_S -> S, shift_P_seed_S -> OFFSET + S.

    Mirrors the numbering the create_*_data_stream targets pass to make_data_stream.
    Keyed on the stream alone, never on the method cell, so every arm sees the same
    auxiliary randomness on a given replicate (common random numbers).
    """
    assert run_seed_key.startswith(("null_", "shift_")), (
        f"unknown stream family: {run_seed_key}"
    )
    stream_idx = int(run_seed_key.rsplit("_", 1)[1])
    return (
        stream_idx
        if run_seed_key.startswith("null_")
        else SHIFT_SEED_OFFSET + stream_idx
    )


nest = SConsWrap(Nest(), OUTDIR, alias_environment=localenv)

nest.add("config",
    # ["crown_white"],
    list(TILT_CONFIGS)
)
# Keyed by epsilon: each shift strength gets its own summaries, all_summary.csv and
# figures. Defined after config so aggregations stay within a single config.
nest.add_aggregate("cell_summaries", dict)
nest.add_aggregate("ctm_cell_summaries", dict)


@nest.add_target_with_env(localenv)
def assemble_pools(env, outdir, c):
    """Build the config's p0/p1 pool CSVs, CLIP embeddings, mapping and true concepts.

    Wired in only when the pools are absent (delete data/pools/seabirds/CONFIG to force
    a rebuild). No _run_cmd: CLIP over the images doesn't fit the 2-cpu/5G srun profile,
    and the cluster is shipped the pools rather than the images.
    """
    if exists(pool_path(c["config"], "embeddings.npz")):
        return None
    # NOTE: Download these CUB files prior to running scons
    sources = [
        path_join("data", "CUB_200_2011", "images.txt"),
        path_join("data", "CUB_200_2011", "image_class_labels.txt"),
        CLASSES_TXT,
        path_join("data", "CUB_200_2011", "attributes", "image_attribute_labels.txt"),
        path_join("data", "attributes.txt"),
    ]
    targets = [
        pool_path(c["config"], name)
        for name in (
            "p0_pool.csv",
            "p1_pool.csv",
            "embeddings.npz",
            "mapping.csv",
            "true_concepts.json",
            "assemble.log",
        )
    ]
    # attribute names carry '::' and parentheses: quote them for the shell
    cmd = [
        "python",
        "src/assemble_cub_tilt.py",
        "--cub-dir",
        CUB_DIR,
        "--population-classes",
        *population_classes(),
        "--tilt-attributes",
        *[f'"{a}"' for a in TILT_CONFIGS[c["config"]]],
        "--distractor-attributes",
        *[f'"{a}"' for a in DISTRACTOR_ATTRIBUTES[c["config"]]],
        "--beta",
        TILT_BETA,
        "--beta0",
        TILT_BETA0,
        "--seed",
        POOL_SEED,
        "--n-p0",
        N_P0,
        "--n-p1",
        N_P1,
        "--embed-model",
        EMBED_MODEL,
        "--p0-pool-path",
        "${TARGETS[0]}",
        "--p1-pool-path",
        "${TARGETS[1]}",
        "--embeddings-path",
        "${TARGETS[2]}",
        "--mapping-path",
        "${TARGETS[3]}",
        "--true-concepts-path",
        "${TARGETS[4]}",
        "--log",
        "${TARGETS[5]}",
    ]
    if c["config"] in CONSENSUS_CONFIGS:
        cmd.append("--consensus")
    if EMBED_LOCAL_ONLY:
        cmd.append("--local-files-only")
    return env.Command(targets, sources, " ".join(map(str, cmd)))


if any(t.startswith("sae") for t in CONCEPT_LEARNER_TYPES):
    @nest.add_target_with_env(localenv)
    def train_sae(env, outdir, c):
        """Train a TopK SAE on the pool embeddings -> checkpoint + settings."""
        sources = [pool_path(c["config"], "embeddings.npz")]
        targets = [
            path_join(outdir, "sae", f"SAE_M={SAE_M}_K={SAE_K}.pt"),
            path_join(outdir, "sae", "sae_settings.json"),
        ]
        cmd = [
            "python",
            "src/train_sae.py",
            "--embeddings-path",
            "${SOURCES[0]}",
            "--checkpoint-dir",
            path_join("exp_cub", outdir, "sae"),
            "--M",
            SAE_M,
            "--K",
            SAE_K,
        ]
        return env.Command(targets, sources, _run_cmd(cmd, use_slurm=True))


@nest.add_target_with_env(localenv)
def write_text_direction(env, outdir, c):
    """Embed each arm's IC/OC descriptions -> directions_<arm>.npz (runs once).

    EMBED_MODEL must match the committed embeddings: the direction has to live in
    the same space as the stream.

    Returns {arm: nodes} so create_ctm_config can select its arm by key.
    """
    nodes = {}
    for variant, descriptions_json in _ctm_direction_files(c["config"]).items():
        targets = [
            path_join(outdir, f"directions_{variant}.npz"),
            path_join(outdir, f"directions_{variant}.log"),
        ]
        cmd = [
            "python",
            "src/write_text_direction.py",
            "--descriptions-json",
            "${SOURCES[0]}",
            "--embed-model",
            EMBED_MODEL,
            "--out",
            "${TARGETS[0]}",
            "--log",
            "${TARGETS[1]}",
        ]
        if EMBED_LOCAL_ONLY:
            cmd.append("--local-files-only")
        nodes[variant] = env.Command(
            targets, [descriptions_json], _run_cmd(cmd, mem=TORCH_MEM, use_slurm=False)
        )
    return nodes


@nest.add_target_with_env(localenv)
def write_pool_direction(env, outdir, c):
    """Empirical pool direction mean(p1) - mean(p0) -> directions_embedding-oracle.npz.

    The oracle upper bound for the guided CTM: the realized shift axis itself.
    """
    sources = [
        pool_path(c["config"], "embeddings.npz"),
        pool_path(c["config"], "mapping.csv"),
    ]
    targets = [
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.npz"),
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.log"),
    ]
    cmd = [
        "python",
        "src/write_pool_direction.py",
        "--embeddings-path",
        "${SOURCES[0]}",
        "--mapping-csv",
        "${SOURCES[1]}",
        "--label",
        f"{c['config']}_pool",
        "--out",
        "${TARGETS[0]}",
        "--log",
        "${TARGETS[1]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.add_aggregate("seed_dict", dict)
nest.add_aggregate("bertopic_llm_debug_csvs", dict)
nest.add_aggregate("identity_debug_csvs", dict)

nest.add("null_seed", range(N_NULL_SEEDS), label_func=lambda c: f"null/seed_{c}")


@nest.add_target_with_env(localenv)
def create_null_data_stream(env, outdir, c):
    """Generate null data stream CSV for this seed."""
    sources = [
        pool_path(c["config"], "embeddings.npz"),
        pool_path(c["config"], "mapping.csv"),
    ]
    targets = [
        path_join(outdir, "stream.csv"),
        path_join(outdir, "stream.log"),
        path_join(outdir, "stream_metadata.json"),
    ]
    cmd = [
        "python",
        "src/make_data_stream.py",
        "--seed",
        c["null_seed"],
        "--pre-p1-fraction",
        PRE_P1_FRACTION,
        "--n-controls",
        K_CALIB,
        "--n-pre",
        NULL_LEN,
        "--n-post",
        0,
        "--embeddings-path",
        "${SOURCES[0]}",
        "--mapping-path",
        "${SOURCES[1]}",
        "--out-stream-csv",
        "${TARGETS[0]}",
        "--log",
        "${TARGETS[1]}",
        "--out-metadata",
        "${TARGETS[2]}",
    ]
    c["seed_dict"][f"null_{c['null_seed']}"] = targets[0]
    return env.Command(targets, sources, _run_cmd(cmd))


nest.pop("null_seed")


nest.add_aggregate("metadata_list", list)
nest.add("post_p1_fraction", POST_P1_FRACTIONS, label_func=lambda c: f"post_p1_{c}")
nest.add("seed", range(N_SEEDS), label_func=lambda c: f"seed_{c}")


@nest.add_target_with_env(localenv)
def create_shift_data_stream(env, outdir, c):
    """Generate shift data stream CSV for this (epsilon, seed)."""
    sources = [
        pool_path(c["config"], "embeddings.npz"),
        pool_path(c["config"], "mapping.csv"),
    ]
    targets = [
        path_join(outdir, "stream.csv"),
        path_join(outdir, "stream.log"),
        path_join(outdir, "stream_metadata.json"),
    ]
    cmd = [
        "python",
        "src/make_data_stream.py",
        "--seed",
        SHIFT_SEED_OFFSET + c["seed"],
        "--pre-p1-fraction",
        PRE_P1_FRACTION,
        "--post-p1-fraction",
        c["post_p1_fraction"],
        "--n-pre",
        N_PRE,
        "--n-post",
        N_POST,
        "--n-controls",
        K_CALIB,
        "--embeddings-path",
        "${SOURCES[0]}",
        "--mapping-path",
        "${SOURCES[1]}",
        "--out-stream-csv",
        "${TARGETS[0]}",
        "--log",
        "${TARGETS[1]}",
        "--out-metadata",
        "${TARGETS[2]}",
    ]
    c["seed_dict"][f"shift_{c['post_p1_fraction']}_seed_{c['seed']}"] = targets[0]
    c["metadata_list"].append(targets[2])
    return env.Command(targets, sources, _run_cmd(cmd))


nest.pop("post_p1_fraction")

nest.add(
    "changepoint_learner", CHANGEPOINT_LEARNER_NAMES, label_func=lambda c: f"cl_{c}"
)
nest.add("classifier", CLASSIFIERS, label_func=lambda c: f"clf_{c}")
nest.add(
    "concept_learner_type",
    lambda c: [
        t
        for t in CONCEPT_LEARNER_TYPES
        if t != "bertopic_llm" or c["changepoint_learner"] in LLM_CP_LEARNERS
    ],
    label_func=lambda c: f"clt_{c}",
)
nest.add(
    "cp_feature_source",
    lambda c: CHANGEPOINT_FEATURE_DICT[c["concept_learner_type"]],
    label_func=lambda c: f"cpfeat_{c}",
)

nest.add(
    "single_concept",
    lambda c: [1],
    label_func=lambda c: f"single_concept_{c}")

nest.add(
    "search_all_sizes",
    lambda c: [False] if c["concept_learner_type"] == "identity" else [True],
    label_func=lambda c: f"search_all_sz_{c}")

nest.add(
    "llm_model",
    lambda c: LLM_MODELS if c["concept_learner_type"] in LLM_LEARNER_TYPES else ["none"],
    label_func=lambda c: f"llm_{c.replace('/', '_').replace('.', '_')}")

@nest.add_target_with_env(localenv)
def create_scl_config(env, outdir, c):
    """Write SCLConfig JSON for this cell (subset_scan only, full annotation)."""
    targets = [path_join(outdir, "scl_config.json")]
    sources = []
    is_loop_arm = c["concept_learner_type"] in CONCEPT_TYPES
    n_init_concepts = (
        N_INIT_CONCEPTS if is_loop_arm else SAE_M if _is_sae(c) else 0
    )
    n_new = LLM_N_NEW_CONCEPTS if is_loop_arm else N_NEW_CONCEPTS_PER_UPDATE
    cmd = [
        "python",
        "src/write_scl_config.py",
        "--out",
        "${TARGETS[0]}",
        "--concept-learner-type",
        (
            "oracle"
            if c["concept_learner_type"].startswith("oracle")
            else "sae"
            if _is_sae(c)
            else c["concept_learner_type"]
        ),
        "--scl-variant",
        SCL_VARIANT,
        "--is-image",
        "--n-burn-in",
        N_BURN_IN,
        "--seed",
        12345,
        "--n-init-concepts",
        n_init_concepts,
        "--n-new-concepts-per-update",
        n_new,
        "--max-unpenalized-dim",
        MAX_UNPENALIZED_DIM,
        "--cache-mode",
        (
            "per_stream"
            if c["concept_learner_type"] in LLM_LEARNER_TYPES
            else "shared"
        ),
        "--classifier-type",
        c["classifier"],
    ]

    if c["search_all_sizes"]:
        cmd.append("--search-all-sizes")

    if _is_sae(c):
        sources = [
            c["train_sae"][0],
            pool_path(c["config"], "embeddings.npz"),
            pool_path(c["config"], "mapping.csv"),
        ]
        cmd += [
            "--sae-checkpoint-path",
            "${SOURCES[0]}",
            "--sae-embeddings-path",
            "${SOURCES[1]}",
            "--sae-mapping-path",
            "${SOURCES[2]}",
        ]
        if c["concept_learner_type"] == "sae_online":
            cmd += [
                "--sae-refit-every",
                SAE_REFIT_EVERY,
                "--sae-refit-epochs",
                SAE_REFIT_EPOCHS,
            ]
    elif c["concept_learner_type"] == "mock":
        cmd += ["--noise-rate", MOCK_NOISE_RATE]
    elif c["concept_learner_type"] == "oracle_random_pool":
        sources = [
            pool_path(c["config"], "p0_pool.csv"),
            pool_path(c["config"], "p1_pool.csv"),
        ]
        true_cols = [f'"{col}"' for col in _oracle_concept_cols(c["config"])]
        cmd += [
            "--oracle-pool-csvs",
            "${SOURCES[0]}",
            "${SOURCES[1]}",
            "--oracle-concept-cols",
            *true_cols,
            "--oracle-variant",
            c["concept_learner_type"],
            "--oracle-proposal-mode",    "random_pool",
            "--oracle-informative-cols", *true_cols,
        ]
    elif c["concept_learner_type"] == "bertopic_llm":
        cmd += [
            "--llm-keyphrase-model",
            c["llm_model"],
            "--prompt-keyphrase-file",
            PROMPT_KEYPHRASE_FILE,
            "--keyphrase-batch-size",
            LLM_BATCH_SIZE,
            "--llm-proposer-model",
            c["llm_model"],
            "--prompt-proposer-iter-file",
            PROMPT_BERTOPIC_ITER_FILE,
            "--prompt-proposer-init-file",
            PROMPT_BERTOPIC_INIT_FILE,
            "--n-bertopic-topics",
            N_BERTOPIC_TOPICS,
            "--llm-annotator-model",
            c["llm_model"],
            "--prompt-annotator-file",
            PROMPT_ANNOTATOR_FILE,
            "--annotator-batch-size",
            LLM_BATCH_SIZE,
            "--single-concept-mode" if c["single_concept"] else "",
        ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.add_aggregate("result_pkls", list)
nest.add("run_seed", _capped_run_seeds)


@nest.add_target_with_env(localenv)
def run_monitor(env, outdir, c):
    sources = [
        pool_path(c["config"], "embeddings.npz"),
        c["seed_dict"][c["run_seed"]],
        c["create_scl_config"][0],
    ]
    targets = [
        path_join(outdir, "result_whiten.pkl"),
        path_join(outdir, "run_whiten.log"),
        path_join(outdir, "debug_whiten.csv"),
        path_join(outdir, "concept_episodes_whiten.csv"),
    ]
    cmd = [
        "python",
        "src/run_monitor.py",
        "--scl-config",
        "${SOURCES[2]}",
        "--changepoint-learner",
        c["changepoint_learner"],
        "--cp-feature-source",
        c["cp_feature_source"],
        "--seed",
        _monitor_seed(c["run_seed"]),
        "--lam",
        LAM,
        "--alpha",
        ALPHA,
        "--max-m-statistic",
        MAX_M_STATISTIC if c["concept_learner_type"] == "bertopic_llm" else (MAX_M_STATISTIC * 3),
        "--candidate-step",
        CANDIDATE_STEP,
        "--min-block",
        MIN_BLOCK,
        "--embeddings-path",
        "${SOURCES[0]}",
        "--stream-csv",
        "${SOURCES[1]}",
        "--out",
        "${TARGETS[0]}",
        "--log",
        "${TARGETS[1]}",
        "--debug-csv",
        "${TARGETS[2]}",
        "--concept-episodes-csv",
        "${TARGETS[3]}",
    ]
    save_keyphrases = c["concept_learner_type"] in LLM_LEARNER_TYPES
    if save_keyphrases:
        targets.append(path_join(outdir, "keyphrase_outputs.csv"))
        cmd += [
            "--keyphrase-csv ${TARGETS[4]}",
        ]

    if c["concept_learner_type"] == "sae_online":
        targets.append(path_join(outdir, "sae_final.pt"))
        cmd += ["--sae-final-checkpoint", f"${{TARGETS[{len(targets) - 1}]}}"]

    stream_cache = path_join(dirname(c["seed_dict"][c["run_seed"]]), "cache.db")
    if c["concept_learner_type"] in LLM_LEARNER_TYPES:
        sources = sources + PROMPT_SOURCES
        cmd += ["--cache-file", path_join("exp_cub", stream_cache)]

    c["result_pkls"].append(targets[0])
    if c["run_seed"].startswith("shift_"):
        if c["concept_learner_type"] == "bertopic_llm":
            c["bertopic_llm_debug_csvs"][c["run_seed"]] = targets[2]
        elif c["concept_learner_type"] == "identity":
            c["identity_debug_csvs"][c["run_seed"]] = targets[2]
    result = env.Command(targets, sources, _run_cmd(cmd, n_cpus=2))
    if c["concept_learner_type"] in LLM_LEARNER_TYPES:
        env.SideEffect(stream_cache, result)
    return result


@nest.add_target_with_env(localenv)
def plot_e_statistic(env, outdir, c):
    sources = [c["run_monitor"][2]]
    targets = [
        path_join(outdir, "e_statistic.png"),
        path_join(outdir, "plot_e_statistic.log"),
    ]
    if int(c["run_seed"].split("_")[-1]) < 2:
        cmd = [
            "python",
            "src/plot_e_statistic.py",
            "--debug-csv",
            "${SOURCES[0]}",
            "--fig-path",
            "${TARGETS[0]}",
            "--log",
            "${TARGETS[1]}",
        ]
        return env.Command(targets, sources, _run_cmd(cmd))


nest.pop("run_seed")


@nest.add_target_with_env(localenv)
def concept_prevalence(env, outdir, c):
    """Aggregate concept prevalence before/after changepoint (bertopic_llm only)."""
    if c["concept_learner_type"] != "bertopic_llm":
        return None
    caps = SEED_CAPS.get(c["concept_learner_type"])
    shift_pat = f"seed_{_seed_class(caps and caps['shift'])}"
    shift_res_globs = []
    for pkl_path in c["result_pkls"]:
        if "seed_0" in pkl_path and "null" not in pkl_path:
            shift_res_globs.append(path_join("exp_cub", pkl_path.replace("seed_0", shift_pat)))
    if not shift_res_globs:
        return None
    sources = c["result_pkls"]
    targets = [
        path_join(outdir, "concept_prevalence.csv"),
        path_join(outdir, "concept_prevalence.log"),
    ]
    cmd = [
        "python",
        "src/aggregate_concept_prevalence.py",
        "--result-glob",
        " ".join([f'"{gl}"' for gl in shift_res_globs]),
        "--changepoint",
        N_PRE,
        "--out-csv",
        "${TARGETS[0]}",
        "--log",
        "${TARGETS[1]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


@nest.add_target_with_env(localenv)
def cell_summary(env, outdir, c):
    """Summarize per configuration of the monitoring method, once per epsilon.

    aggregate_cell pools every shift glob it is given, which would average EDD over
    shift strengths, so each epsilon is summarized on its own against the same nulls.
    """
    # Cap-aware glob classes keep result and metadata counts equal for capped
    # arms (aggregate_cell zips them positionally).
    caps = SEED_CAPS.get(c["concept_learner_type"])
    # null: 0 -> this arm runs no null streams, so it has no empirical ARL0 to measure
    # and depends on no null artifacts (see aggregate_cell --skip-null).
    skip_null = (N_NULL_SEEDS == 0) or (caps and caps["null"] == 0)
    shift_pat = f"seed_{_seed_class(caps and caps['shift'])}"
    nodes = []
    for eps in POST_P1_FRACTIONS:
        result_pkls = [
            pkl
            for pkl in c["result_pkls"]
            if "null_" in pkl or f"shift_{eps}_seed_" in pkl
        ]
        metadata_list = [m for m in c["metadata_list"] if f"post_p1_{eps}/" in m]
        null_metas, null_res_glob, null_dat_glob = [], None, None
        if not skip_null:
            null_class = _seed_class(caps and caps["null"])
            null_pat = f"null_{null_class}"
            null_metas = [
                c["seed_dict"][k].replace("stream.csv", "stream_metadata.json")
                for k in c["seed_dict"]
                if k.startswith("null_")
            ]
            null_dat_glob = path_join(
                "exp_cub",
                OUTDIR,
                c["config"],
                "null",
                f"seed_{null_class}",
                "stream_metadata.json",
            )
        sources = [c["create_scl_config"][0]] + result_pkls + metadata_list + null_metas
        shift_res_globs = []
        for pkl_path in result_pkls:
            if "null_0" in pkl_path:
                null_res_glob = path_join(
                    "exp_cub", pkl_path.replace("null_0", null_pat)
                )
            elif "seed_0" in pkl_path:
                shift_res_globs.append(
                    path_join("exp_cub", pkl_path.replace("seed_0", shift_pat))
                )
        shift_dat_globs = []
        for metadata_path in metadata_list:
            if "seed_0" in metadata_path:
                shift_dat_globs.append(
                    path_join("exp_cub", metadata_path.replace("seed_0", shift_pat))
                )
        targets = [
            path_join(outdir, f"eps_{eps}", "summary.csv"),
            path_join(outdir, f"eps_{eps}", "aggregate.log"),
        ]
        cmd = [
            "python",
            "src/aggregate_cell.py",
            "--shift-res-globs",
            " ".join([f'"{gl}"' for gl in shift_res_globs]),
            "--shift-dat-globs",
            " ".join([f'"{gl}"' for gl in shift_dat_globs]),
            "--label",
            c["config"],
            "--post-p1-fraction",
            eps,
            "--threshold-min",
            THRESHOLD_MIN,
            "--threshold-max",
            THRESHOLD_MAX,
            "--n-thresholds",
            N_THRESHOLDS,
            "--n-bootstrap",
            N_BOOTSTRAP,
            "--config-json",
            "${SOURCES[0]}",
            "--e-process",
            "ProposedMethod",
            "--changepoint-learner",
            c["changepoint_learner"],
            "--cp-feature-source",
            c["cp_feature_source"],
            "--k-calib",
            K_CALIB,
            "--out-csv",
            "${TARGETS[0]}",
            "--log",
            "${TARGETS[1]}",
        ]
        cmd += (
            ["--skip-null"]
            if skip_null
            else [
                "--null-res-glob",
                f'"{null_res_glob}"',
                "--null-dat-glob",
                f'"{null_dat_glob}"',
            ]
        )
        c["cell_summaries"].setdefault(eps, []).append(targets[0])
        nodes.append(env.Command(targets, sources, _run_cmd(cmd, use_slurm=False)))
    return nodes


nest.pop("changepoint_learner")


# === Ensemble: combine bertopic_llm and identity monitors ===
def _ensemble_seeds(c):
    """Seeds available in both bertopic_llm and identity debug.csv dicts."""
    return sorted(set(c["bertopic_llm_debug_csvs"]) & set(c["identity_debug_csvs"]))


# Two ways to combine the inputs: "ensemble" averages their per-step p-values and
# recompounds the bet; "ensemble_m" averages their M_t, which is guaranteed to cross every
# threshold <= MAX_M_STATISTIC / 2 before the first input stops.
ENSEMBLE_COMBINE = {
    # "ensemble": "p_value",
    "ensemble_m": "m_statistic"
}
nest.add("ensemble", list(ENSEMBLE_COMBINE), label_func=lambda c: c)


@nest.add_target_with_env(localenv)
def create_ensemble_config(env, outdir, c):
    """Write minimal config JSON for the ensemble method."""
    targets = [path_join(outdir, "ensemble_config.json")]
    cmd = [
        "python", "src/write_ensemble_config.py",
        "--out",        "${TARGETS[0]}",
        "--n-burn-in",  N_BURN_IN,
        "--concept-learner-type", c["ensemble"],
    ]
    return env.Command(targets, [], _run_cmd(cmd, use_slurm=False))


nest.add_aggregate("ensemble_result_pkls", list)
nest.add("ensemble_seed", _ensemble_seeds, label_func=lambda c: c)


@nest.add_target_with_env(localenv)
def run_ensemble_monitor(env, outdir, c):
    """Combine the bertopic_llm and identity monitors of one stream."""
    bertopic_debug = c["bertopic_llm_debug_csvs"][c["ensemble_seed"]]
    identity_debug = c["identity_debug_csvs"][c["ensemble_seed"]]
    sources = [bertopic_debug, identity_debug]
    targets = [
        path_join(outdir, "result.pkl"),
        path_join(outdir, "run.log"),
        path_join(outdir, "debug.csv"),
    ]
    cmd = [
        "python", "src/run_ensemble_monitor.py",
        "--debug-csv-1",     "${SOURCES[0]}",
        "--debug-csv-2",     "${SOURCES[1]}",
        "--combine",         ENSEMBLE_COMBINE[c["ensemble"]],
        "--lam",             LAM,
        "--max-m-statistic", MAX_M_STATISTIC,
        "--stream-length",   SHIFT_LEN,
        "--out-pkl",         "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
        "--out-debug-csv",   "${TARGETS[2]}",
    ]
    c["ensemble_result_pkls"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("ensemble_seed")


@nest.add_target_with_env(localenv)
def ensemble_cell_summary(env, outdir, c):
    """Summarize ensemble results across seeds, once per epsilon."""
    nodes = []
    for eps in POST_P1_FRACTIONS:
        eps_result_pkls = [
            pkl for pkl in c["ensemble_result_pkls"]
            if f"shift_{eps}_seed_" in pkl
        ]
        if not eps_result_pkls:
            continue
        sources = [c["create_ensemble_config"][0]] + eps_result_pkls
        shift_res_glob = path_join(
            "exp_cub", OUTDIR,
            c["config"],
            c["ensemble"],
            f"shift_{eps}_seed_*",
            "result.pkl",
        )
        shift_dat_glob = path_join(
            "exp_cub", OUTDIR,
            c["config"],
            f"post_p1_{eps}",
            "seed_*",
            "stream_metadata.json",
        )
        targets = [
            path_join(outdir, f"eps_{eps}", "summary.csv"),
            path_join(outdir, f"eps_{eps}", "aggregate.log"),
        ]
        cmd = [
            "python", "src/aggregate_cell.py",
            "--shift-res-globs",      f'"{shift_res_glob}"',
            "--shift-dat-globs",      f'"{shift_dat_glob}"',
            "--skip-null",
            "--label",                c["config"],
            "--post-p1-fraction",     eps,
            "--threshold-min",        THRESHOLD_MIN,
            "--threshold-max",        THRESHOLD_MAX,
            "--n-thresholds",         N_THRESHOLDS,
            "--n-bootstrap",          N_BOOTSTRAP,
            "--config-json",          "${SOURCES[0]}",
            "--e-process",            "ProposedMethod",
            "--changepoint-learner",  "mean_shift",
            "--cp-feature-source",    "concept",
            "--k-calib",              K_CALIB,
            "--out-csv",              "${TARGETS[0]}",
            "--log",                  "${TARGETS[1]}",
        ]
        c["cell_summaries"].setdefault(eps, []).append(targets[0])
        nodes.append(env.Command(targets, sources, _run_cmd(cmd, use_slurm=False)))
    return nodes


nest.pop("ensemble")


# === CTM baseline: scorer sweep over the same streams the SCL uses ===
