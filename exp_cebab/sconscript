Import("env")
localenv = env.Clone()

USE_SLURM = env["use_slurm"]

COMPUTE_PROXY = os.environ.get("COMPUTE_PROXY", "")
PROXY_ENV = (" ".join(f"{v}={COMPUTE_PROXY}"
                      for v in ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy"))
             if COMPUTE_PROXY else "")


def _run_cmd(cmd_parts, n_cpus=2, mem="5G", use_slurm=USE_SLURM):
    full = " ".join(str(x) for x in cmd_parts)
    if use_slurm:
        full = (f"srun --nodes=1 --ntasks=1 --cpus-per-task={n_cpus} "
                f"--mem-per-cpu={mem} --time=72:00:00 env {PROXY_ENV} {full}")
    return full

TORCH_MEM = "8G"

# Embedding sensitivity: DEFAULT_EMBED (the paper's MiniLM) drives every arm; the others
# are swept only for the identity arm and the CTM monitors, under `emb_<key>/`.
DEFAULT_EMBED = "minilm"
EMBED_CONFIGS = {
    "minilm": {
        "model": "sentence-transformers/all-MiniLM-L6-v2",
        "population_emb": "data/population_embeddings.npz",
    },
    "bge_base": {
        "model": "BAAI/bge-base-en-v1.5",
        "population_emb": "data/population_embeddings_bge_base.npz",
    },
}
SENSITIVITY_EMBEDS = [key for key in EMBED_CONFIGS if key != DEFAULT_EMBED]


def _embed_label(key):
    """Path label for an embedding axis value: empty for the default."""
    return "" if key == DEFAULT_EMBED else f"emb_{key}"


OUTDIR = "_output"

# Prompt file per role, in exp_cebab/prompts/. The order fixes run_monitor's prompt sources.
DEFAULT_PROMPT_FILES = {
    "keyphrase": "keyphrases.txt",
    "bertopic_iter": "proposer_bertopic_iter.txt",
    "bertopic_init": "proposer_bertopic_init.txt",
    "annotator": "annotator.txt",
}
# Prompt sensitivity: each variant overrides some roles. "wine_examples" swaps the decor
# example, close to the ambiance shift, for a wine-price example in the three prompts
# that have one; the annotator prompt has none.
PROMPT_VARIANTS = {
    "default": {},
    "wine_examples": {
        "keyphrase": "keyphrases_wine_examples.txt",
        "bertopic_init": "proposer_bertopic_init_wine_examples.txt",
        "bertopic_iter": "proposer_bertopic_iter_wine_examples.txt",
    },
}


def prompt_files(variant):
    """Role -> sconscript-relative prompt path for a variant (defaults + its overrides)."""
    return {
        role: f"prompts/{name}"
        for role, name in {**DEFAULT_PROMPT_FILES, **PROMPT_VARIANTS[variant]}.items()
    }


