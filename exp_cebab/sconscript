CTM_POOL_VARIANT = "embedding-oracle"

# Sliding-window baselines: MMD / LSDD after alibi-detect's online detectors, KS drifted share
# / cosine distance after Evidently. Reference = the stream's K_CALIB controls; statistic
# over the last W stream points, NaN through burn-in.
SLIDING_WINDOW_METHODS = ["mmd", "lsdd", "ks_share", "cosine"]
SLIDING_WINDOW_SIZES   = [10, 20, 30]
KS_ALPHA             = 0.05           # ks_share: a dimension drifts when its KS p-value is <= this
LSDD_N_CENTERS       = K_CALIB // 2   # first controls are kernel centres, the rest the reference
LSDD_LAMBDA_RD_MAX   = 0.2            # alibi default: largest lambda with mean RD below this
LSDD_N_LAMBDA_SPLITS = 200            # reference/window splits of controls + burn-in for lambda

THRESHOLD_MAX_PLOT = THRESHOLD_MAX
THRESHOLD_MAX_PLOT_NULL = MAX_STEPS_NULL - N_BURN_IN
PLOT_HUE_COLS = ["family", "cp_feature_source", "concept_learner_type",
                 "oracle_variant", "sae_variant", "variant", "search_all_sizes",
                 "llm_model", "prompt_variant", "embed_model"]
# plot_cebab --filter specs; a NaN cell passes, i.e. the axis does not apply to that arm.
# The paper figure pins every sensitivity axis at its default.
PAPER_FILTERS = [
    f"embed_model={DEFAULT_EMBED}",
    f"llm_model={DEFAULT_LLM}",
    "prompt_variant=default",
]
# Sensitivity figures, without sliding windows: output subdir -> whether to load the CTM
# rows, and the filters. Each varies one axis and pins the other two at the paper setting.
SENSITIVITY_PLOTS = {
    "sensitivity_llm": {
        "with_ctm": False,
        "filters": [
            "concept_learner_type=bertopic_llm,ensemble_m",
            "prompt_variant=default",
            f"embed_model={DEFAULT_EMBED}",
        ],
    },
    "sensitivity_prompt": {
        "with_ctm": False,
        "filters": [
            "concept_learner_type=bertopic_llm,ensemble_m",
            f"llm_model={DEFAULT_LLM}",
            f"embed_model={DEFAULT_EMBED}",
        ],
    },
    **{
        f"sensitivity_embedding/{key}": {
            "with_ctm": True,
            "filters": [
                "concept_learner_type=identity,ensemble_m",
                f"embed_model={key}",
                f"llm_model={DEFAULT_LLM}",
                "prompt_variant=default",
            ],
        }
        for key in EMBED_CONFIGS
    },
}


def _mirror_outdir(outdir, subdir):
    return (outdir if subdir is None
            else normpath(path_join(OUTDIR, subdir, relpath(outdir, OUTDIR))))


def _seed_class(cap, n_seeds):
    limits = [x for x in (cap, n_seeds) if x is not None]
    return "*" if not limits else f"[0-{min(limits) - 1}]"


def _capped_run_seeds(c):
    caps = SEED_CAPS.get(c["concept_learner_type"])
    if caps is None:
        return list(c["seed_dict"])
    keep = []
    for key in c["seed_dict"]:
        kind = "null" if key.startswith("null_") else "shift"
        if int(key.rsplit("_", 1)[1]) < caps[kind]:
            keep.append(key)
    return keep


def _monitor_seed(run_seed_key):
    assert run_seed_key.startswith(("null_", "shift_")), (
        f"unknown stream family: {run_seed_key}"
    )
    stream_idx = int(run_seed_key.rsplit("_", 1)[1])
    return stream_idx if run_seed_key.startswith("null_") else SHIFT_SEED_OFFSET + stream_idx


nest = SConsWrap(Nest(), OUTDIR, alias_environment=localenv)


@nest.add_target_with_env(localenv)
def embed_population(env, outdir, c):
    """Embed the population.csv rows, in order, with each sensitivity model."""
    nodes = {}
    for key in SENSITIVITY_EMBEDS:
        population_emb = EMBED_CONFIGS[key]["population_emb"]
        cmd = [
            "python", "src/embed_cebab_population.py",
            "--population-csv",     "${SOURCES[0]}",
            "--embed-model",        EMBED_CONFIGS[key]["model"],
            "--out-embeddings-npz", "${TARGETS[0]}",
            "--log",                "${TARGETS[1]}",
        ]
        if EMBED_LOCAL_ONLY:
            cmd.append("--local-files-only")
        nodes[key] = env.Command(
            [population_emb, population_emb.replace(".npz", ".log")],
            [POPULATION_CSV],
            " ".join(map(str, cmd)),
        )
    return nodes


if not (File(POPULATION_CSV).exists() and File(POPULATION_EMB).exists()):
    @nest.add_target_with_env(localenv)
    def build_population(env, outdir, c):
        targets = [POPULATION_CSV, POPULATION_EMB, "data/population.log"]
        cmd = [
            "python", "src/assemble_cebab_population.py",
            "--out-population-csv", "${TARGETS[0]}",
            "--out-embeddings-npz", "${TARGETS[1]}",
            "--log",                "${TARGETS[2]}",
        ]
        return env.Command(targets, [], " ".join(map(str, cmd)))

