nest.pop("run_seed")


@nest.add_target_with_env(localenv)
def ctm_cell_summary(env, outdir, c):
    nodes = []
    skip_null = N_NULL_SEEDS == 0
    result_pkls = c["ctm_result_pkls"]
    seed_class = _seed_class(None, None)
    sources = result_pkls + [c["create_ctm_config"][0]]
    shift_res_globs = []
    null_res_glob = None
    for pkl_path in result_pkls:
        if "null_0" in pkl_path:
            null_res_glob = path_join(
                "exp_cebab", pkl_path.replace("null_0", f"null_{seed_class}"))
        elif "seed_0" in pkl_path:
            shift_res_globs.append(
                path_join("exp_cebab", pkl_path.replace("seed_0", f"seed_{seed_class}")))
    null_dat_glob = path_join("exp_cebab", OUTDIR, c["shift_aspect"], "null", f"seed_{seed_class}",
                                "stream_metadata.json")
    shift_dat_globs = []
    for metadata_path in c["metadata_list"]:
        if "seed_0" in metadata_path:
            shift_dat_globs.append(
                path_join("exp_cebab",
                            metadata_path.replace("seed_0", f"seed_{seed_class}")))
    targets = [
        path_join(outdir, "summary.csv"),
        path_join(outdir, "aggregate.log"),
    ]
    n_result_pkls = len(result_pkls)
    cmd = [
        "python", "src/aggregate_ctm_cell.py",
        "--shift-res-globs", " ".join([f'"{gl}"' for gl in shift_res_globs]),
        "--shift-dat-globs", " ".join([f'"{gl}"' for gl in shift_dat_globs]),
        "--label",           c["shift_aspect"],
        "--threshold-min",   THRESHOLD_MIN,
        "--threshold-max",   THRESHOLD_MAX,
        "--n-thresholds",    N_THRESHOLDS,
        "--n-bootstrap",     N_BOOTSTRAP,
        "--config-json",     f"${{SOURCES[{n_result_pkls}]}}",
        "--out-csv",         "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
    ]
    if skip_null:
        cmd += ["--skip-null"]
    else:
        cmd += ["--null-res-glob", f'"{null_res_glob}"',
                "--null-dat-glob", f'"{null_dat_glob}"']
    c["ctm_cell_summaries"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("ctm_variant")
nest.pop("ctm_scorer")


