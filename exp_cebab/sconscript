@nest.add_target_with_env(localenv)
def assemble_pools(env, outdir, c):
    sources = [POPULATION_CSV, POPULATION_EMB]
    targets = [
        path_join(outdir, "p0_pool.csv"),
        path_join(outdir, "p1_pool.csv"),
        path_join(outdir, "embeddings.npz"),
        path_join(outdir, "mapping.csv"),
        path_join(outdir, "sae_pool.csv"),
        path_join(outdir, "sae_train_embeddings.npz"),
        path_join(outdir, "true_concepts.json"),
        path_join(outdir, "data/assemble.log"),
    ]
    cmd = [
        "python", "src/assemble_cebab.py",
        "--seed",         0,
        "--shift-aspect", c["shift_aspect"],
        "--beta-pre",         BETA_DICT[c["shift_aspect"]]["beta_pre"],
        "--beta-post",         BETA_DICT[c["shift_aspect"]]["beta_post"],
        "--beta0-pre",         BETA_DICT[c["shift_aspect"]]["beta0_pre"],
        "--beta0-post",         BETA_DICT[c["shift_aspect"]]["beta0_post"],
        "--side-fracs",   *SIDE_FRACS,
        "--population-csv",            "${SOURCES[0]}",
        "--population-embeddings-npz", "${SOURCES[1]}",
        "--p0-pool-path",        "${TARGETS[0]}",
        "--p1-pool-path",        "${TARGETS[1]}",
        "--embeddings-path",     "${TARGETS[2]}",
        "--mapping-path",        "${TARGETS[3]}",
        "--sae-pool-path",       "${TARGETS[4]}",
        "--sae-embeddings-path", "${TARGETS[5]}",
        "--true-concepts-path",  "${TARGETS[6]}",
        "--log",                 "${TARGETS[7]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


@nest.add_target_with_env(localenv)
def augment_oracle_random_pool(env, outdir, c):
    sources = c["assemble_pools"][:2]
    targets = [
        path_join(outdir, "oracle_random_pool", "p0_pool_aug.csv"),
        path_join(outdir, "oracle_random_pool", "p1_pool_aug.csv"),
        path_join(outdir, "oracle_random_pool", "augment.log"),
    ]
    cmd = [
        "python", "src/augment_oracle_pool.py",
        "--pool-csvs",     "${SOURCES[0]}", "${SOURCES[1]}",
        "--out-csvs",      "${TARGETS[0]}", "${TARGETS[1]}",
        "--n-independent", ORACLE_RANDOM_POOL_N_NOISE_INDEPENDENT,
        "--noise-p",       ORACLE_RANDOM_POOL_NOISE_P,
        "--n-correlated",  ORACLE_RANDOM_POOL_N_NOISE_CORRELATED,
        "--true-col",      *_oracle_concept_cols("oracle_true", c["shift_aspect"]),
        "--zero-fill-cols", *ALL8_CONCEPT_COLS,
        "--flip-rate",     ORACLE_RANDOM_POOL_FLIP_RATE,
        "--seed",          12345,
        "--log",           "${TARGETS[2]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


def _is_sae(c):
    return c["concept_learner_type"].startswith("sae")


if any(t.startswith("sae") for t in CONCEPT_LEARNER_TYPES):
    @nest.add_target_with_env(localenv)
    def train_sae(env, outdir, c):
        sources = [c["assemble_pools"][5]]
        targets = [
            path_join(outdir, "sae", f"SAE_M={SAE_M}_K={SAE_K}.pt"),
            path_join(outdir, "sae", "sae_settings.json"),
        ]
        cmd = [
            "python", "src/train_sae.py",
            "--embeddings-path", "${SOURCES[0]}",
            "--checkpoint-dir",  path_join("exp_cebab", outdir, "sae"),
            "--M", SAE_M,
            "--K", SAE_K,
        ]
        return env.Command(targets, sources, _run_cmd(cmd, use_slurm=True))


@nest.add_target_with_env(localenv)
def write_text_direction(env, outdir, c):
    nodes = {}
    for variant, descriptions_json in _ctm_direction_files(c["shift_aspect"]).items():
        targets = [
            path_join(outdir, f"directions_{variant}.npz"),
            path_join(outdir, f"directions_{variant}.log"),
        ]
        cmd = [
            "python", "src/write_text_direction.py",
            "--descriptions-json", "${SOURCES[0]}",
            "--embed-model",       EMBED_MODEL,
            "--out",               "${TARGETS[0]}",
            "--log",               "${TARGETS[1]}",
        ]
        if EMBED_LOCAL_ONLY:
            cmd.append("--local-files-only")
        nodes[variant] = env.Command(targets, [descriptions_json],
                                     _run_cmd(cmd, mem=TORCH_MEM, use_slurm=False))
    return nodes

@nest.add_target_with_env(localenv)
def write_pool_direction(env, outdir, c):
    sources = [
        c["assemble_pools"][2],
        c["assemble_pools"][3]
    ]
    targets = [
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.npz"),
        path_join(outdir, f"directions_{CTM_POOL_VARIANT}.log"),
    ]
    cmd = [
        "python", "src/write_pool_direction.py",
        "--embeddings-path", "${SOURCES[0]}",
        "--mapping-csv",     "${SOURCES[1]}",
        "--label",           f"{c['shift_aspect']}_pool",
        "--out",             "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


