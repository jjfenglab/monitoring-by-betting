@nest.add_target_with_env(localenv)
def final_plot(env, outdir, c):
    """The paper figure per sliding-window size, at the paper setting."""
    sources = [c["aggregate_all"][0], c["aggregate_all_ctm"][0],
               c["aggregate_all_sliding_window"][0]]
    nodes = []
    for window_size in SLIDING_WINDOW_SIZES:
        targets = [
            path_join(outdir, f"W_{window_size}", "arl_edd.png"),
            path_join(outdir, f"W_{window_size}", "calibration_arl.png"),
            path_join(outdir, f"W_{window_size}", "plot.log"),
        ]
        cmd = [
            "python", "src/plot_cebab.py",
            "--csv",             "${SOURCES[0]}",
            "--ctm-csv",         "${SOURCES[1]}",
            "--sliding-window-csv", "${SOURCES[2]}",
            "--sliding-window-size", window_size,
            "--n-burn-in",       N_BURN_IN,
            "--out-nominal",     "${TARGETS[0]}",
            "--out-calibration", "${TARGETS[1]}",
            "--n-pre",           N_PRE,
            "--threshold-min",   THRESHOLD_MIN,
            "--threshold-max",   THRESHOLD_MAX,
            "--threshold-min-null", THRESHOLD_MIN,
            "--threshold-max-null", THRESHOLD_MAX_PLOT_NULL,
            "--hue-cols",        *PLOT_HUE_COLS,
            "--title-prefix",    f'"{c["shift_aspect"]} W={window_size}"',
            "--log",             "${TARGETS[2]}",
            "--baseline", "family=CTM,MMD,LSDD,KS_SHARE,COSINE",
        ]
        cmd += [arg for spec in PAPER_FILTERS for arg in ("--filter", spec)]
        nodes.append(env.Command(targets, sources, _run_cmd(cmd, use_slurm=False)))
    return nodes


@nest.add_target_with_env(localenv)
def sensitivity_plots(env, outdir, c):
    """One figure per SENSITIVITY_PLOTS entry; no sliding-window baselines."""
    nodes = []
    for subdir, plot in SENSITIVITY_PLOTS.items():
        sources = [c["aggregate_all"][0]]
        if plot["with_ctm"]:
            sources.append(c["aggregate_all_ctm"][0])
        targets = [
            path_join(outdir, subdir, "arl_edd.png"),
            path_join(outdir, subdir, "calibration_arl.png"),
            path_join(outdir, subdir, "plot.log"),
        ]
        cmd = [
            "python", "src/plot_cebab.py",
            "--csv",             "${SOURCES[0]}",
            "--n-burn-in",       N_BURN_IN,
            "--out-nominal",     "${TARGETS[0]}",
            "--out-calibration", "${TARGETS[1]}",
            "--n-pre",           N_PRE,
            "--threshold-min",   THRESHOLD_MIN,
            "--threshold-max",   THRESHOLD_MAX,
            "--threshold-min-null", THRESHOLD_MIN,
            "--threshold-max-null", THRESHOLD_MAX_PLOT_NULL,
            "--hue-cols",        *PLOT_HUE_COLS,
            "--title-prefix",    f'"{c["shift_aspect"]} {subdir}"',
            "--log",             "${TARGETS[2]}",
        ]
        if plot["with_ctm"]:
            cmd += ["--ctm-csv", "${SOURCES[1]}", "--baseline", "family=CTM"]
        cmd += [arg for spec in plot["filters"] for arg in ("--filter", spec)]
        nodes.append(env.Command(targets, sources, _run_cmd(cmd, use_slurm=False)))
    return nodes
