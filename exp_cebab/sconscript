@nest.add_target_with_env(localenv)
def run_sliding_window_detector(env, outdir, c):
    """Sliding-window statistic (MMD^2 / LSDD / KS share / cosine) of one stream vs its controls."""
    sources = [
        c["assemble_pools"][2],
        c["seed_dict"][c["run_seed"]],
    ]
    targets = [
        path_join(outdir, "result.pkl"),
        path_join(outdir, "run.log"),
        path_join(outdir, "debug.csv"),
    ]
    cmd = [
        "python", "src/run_sliding_window_detector.py",
        "--method",          c["sliding_window_method"],
        "--window-size",     c["window_size"],
        "--n-burn-in",       N_BURN_IN,
        "--stream-csv",      "${SOURCES[1]}",
        "--embeddings-path", "${SOURCES[0]}",
        "--seed",            _monitor_seed(c["run_seed"]),
        "--out",             "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
        "--debug-csv",       "${TARGETS[2]}",
    ]
    if c["sliding_window_method"] == "lsdd":
        cmd += [
            "--n-centers",       LSDD_N_CENTERS,
            "--lambda-rd-max",   LSDD_LAMBDA_RD_MAX,
            "--n-lambda-splits", LSDD_N_LAMBDA_SPLITS,
        ]
    if c["sliding_window_method"] == "ks_share":
        cmd += ["--ks-alpha", KS_ALPHA]
    if c["run_seed"].startswith("null_"):
        c["sliding_window_null_pkls"].append(targets[0])
    else:
        metadata = c["seed_dict"][c["run_seed"]].replace("stream.csv", "stream_metadata.json")
        c["sliding_window_shift_runs"].append((targets[0], metadata))
    return env.Command(targets, sources, _run_cmd(cmd))


@nest.add_target_with_env(localenv)
def plot_sliding_window_statistic(env, outdir, c):
    """The stream's statistic over time, for the first two null and shift streams."""
    sources = [c["run_sliding_window_detector"][2]]
    targets = [
        path_join(outdir, "sliding_window_statistic.png"),
        path_join(outdir, "plot_sliding_window_statistic.log"),
    ]
    if int(c["run_seed"].rsplit("_", 1)[1]) < 2:
        cmd = [
            "python", "src/plot_sliding_window_statistic.py",
            "--debug-csv",   "${SOURCES[0]}",
            "--method",      c["sliding_window_method"],
            "--window-size", c["window_size"],
            "--fig-path",    "${TARGETS[0]}",
            "--log",         "${TARGETS[1]}",
        ]
        return env.Command(targets, sources, _run_cmd(cmd))


nest.pop("run_seed")


@nest.add_target_with_env(localenv)
def calibrate_sliding_window_thresholds(env, outdir, c):
    """One threshold per nominal ARL0 (the SCL sweep's grid), calibrated on the null runs."""
    null_pkls = c["sliding_window_null_pkls"]
    assert null_pkls, "sliding-window baselines calibrate on null streams: set N_NULL_SEEDS > 0"
    targets = [
        path_join(outdir, "thresholds.csv"),
        path_join(outdir, "null_arl_curve.csv"),
        path_join(outdir, "null_lambda_counts.csv"),
        path_join(outdir, "calibrate.log"),
    ]
    cmd = [
        "python", "src/calibrate_sliding_window_thresholds.py",
        "--null-res-glob",         f'"{path_join("exp_cebab", outdir, "null_*", "result.pkl")}"',
        "--n-null-runs",           len(null_pkls),
        "--n-burn-in",             N_BURN_IN,
        "--threshold-min",         THRESHOLD_MIN,
        "--threshold-max",         THRESHOLD_MAX,
        "--n-thresholds",          N_THRESHOLDS,
        "--out-thresholds-csv",    "${TARGETS[0]}",
        "--out-curve-csv",         "${TARGETS[1]}",
        "--out-lambda-counts-csv", "${TARGETS[2]}",
        "--log",                   "${TARGETS[3]}",
    ]
    return env.Command(targets, null_pkls, _run_cmd(cmd, use_slurm=False))


@nest.add_target_with_env(localenv)
def sliding_window_cell_summary(env, outdir, c):
    """EDD on the shift runs at the calibrated thresholds; nominal_arl is the ARL0 target."""
    shift_pkls = [pkl for pkl, _ in c["sliding_window_shift_runs"]]
    shift_metas = [meta for _, meta in c["sliding_window_shift_runs"]]
    sources = [c["calibrate_sliding_window_thresholds"][0]] + shift_pkls + shift_metas
    targets = [
        path_join(outdir, "summary.csv"),
        path_join(outdir, "aggregate.log"),
    ]
    cmd = [
        "python", "src/aggregate_sliding_window_cell.py",
        "--shift-res-glob", f'"{path_join("exp_cebab", outdir, "shift_*_seed_*", "result.pkl")}"',
        "--n-shift-runs",   len(shift_pkls),
        "--thresholds-csv", "${SOURCES[0]}",
        "--label",          c["shift_aspect"],
        "--n-burn-in",      N_BURN_IN,
        "--n-bootstrap",    N_BOOTSTRAP,
        "--k-calib",        K_CALIB,
        "--out-csv",        "${TARGETS[0]}",
        "--log",            "${TARGETS[1]}",
    ]
    c["sliding_window_cell_summaries"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("window_size")
nest.pop("sliding_window_method")


