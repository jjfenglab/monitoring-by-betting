@nest.add_target_with_env(localenv)
def create_shift_data_stream(env, outdir, c):
    sources = [
        c["assemble_pools"][2],
        c["assemble_pools"][3]
    ]
    targets = [
        path_join(outdir, "stream.csv"),
        path_join(outdir, "stream.log"),
        path_join(outdir, "stream_metadata.json"),
    ]
    cmd = [
        "python", "src/make_data_stream.py",
        "--seed",             SHIFT_SEED_OFFSET + c["seed"],
        "--pre-p1-fraction",  PRE_P1_FRACTION,
        "--post-p1-fraction", c['post_p1_fraction'],
        "--n-pre",            N_PRE,
        "--n-post",           N_POST,
        "--n-controls",       K_CALIB,
        "--embeddings-path",  "${SOURCES[0]}",
        "--mapping-path",     "${SOURCES[1]}",
        "--out-stream-csv",   "${TARGETS[0]}",
        "--log",              "${TARGETS[1]}",
        "--out-metadata",     "${TARGETS[2]}",
    ]
    c["seed_dict"][f"shift_{c['post_p1_fraction']}_seed_{c['seed']}"] = targets[0]
    c["metadata_list"].append(targets[2])
    return env.Command(targets, sources, _run_cmd(cmd))

