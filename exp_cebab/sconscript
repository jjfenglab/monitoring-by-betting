import os
from itertools import product
from os.path import dirname, normpath, relpath
from os.path import join as path_join
from shlex import quote as shell_quote

from nestly import Nest
from nestly.scons import SConsWrap
from SCons.Script import File, Import

Import("env")
localenv = env.Clone()

USE_SLURM = env["use_slurm"]

COMPUTE_PROXY = os.environ.get("COMPUTE_PROXY", "")
PROXY_ENV = (" ".join(f"{v}={COMPUTE_PROXY}"
                      for v in ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy"))
             if COMPUTE_PROXY else "")


def _run_cmd(cmd_parts, n_cpus=2, mem="5G", use_slurm=USE_SLURM):
    full = " ".join(str(x) for x in cmd_parts)
    if use_slurm:
        full = (f"srun --nodes=1 --ntasks=1 --cpus-per-task={n_cpus} "
                f"--mem-per-cpu={mem} --time=72:00:00 env {PROXY_ENV} {full}")
    return full

TORCH_MEM = "8G"

OUTDIR = "_output"

PROMPT_KEYPHRASE_FILE         = "exp_cebab/prompts/keyphrases.txt"
PROMPT_BERTOPIC_ITER_FILE     = "exp_cebab/prompts/proposer_bertopic_iter.txt"
PROMPT_BERTOPIC_INIT_FILE     = "exp_cebab/prompts/proposer_bertopic_init.txt"
PROMPT_ANNOTATOR_FILE         = "exp_cebab/prompts/annotator.txt"
PROMPT_SOURCES = ["prompts/keyphrases.txt",
                  "prompts/proposer_bertopic_iter.txt", "prompts/proposer_bertopic_init.txt",
                  "prompts/annotator.txt"]
LLM_MODELS = ["azure/gpt-4.1-mini-2025-04-14"]
LLM_BATCH_SIZE = 50

POPULATION_CSV  = "data/population.csv"
POPULATION_EMB  = "data/population_embeddings.npz"

BETA_DICT = {
    "ambiance_mentioned": {
        "beta_pre": 0,
        "beta0_pre": 0,
        "beta_post": 4,
        "beta0_post": -4,
    },
}

SIDE_FRACS   = [0.2, 0.55, 0.25]
EMBED_MODEL     = "sentence-transformers/all-MiniLM-L6-v2"
EMBED_LOCAL_ONLY = True

N_NULL_SEEDS      = 0
N_SEEDS           = 2
SEED_CAPS = {}

SHIFT_SEED_OFFSET = 10000
PRE_P1_FRACTION   = 0.0
POST_P1_FRACTIONS = [
    1.0
    ]
N_PRE             = 50
N_POST            = 300
NULL_LEN          = N_PRE + N_POST
SHIFT_LEN         = N_PRE + N_POST
K_CALIB           = 30

MAX_STEPS_NULL       = NULL_LEN
MAX_STEPS_SHIFT      = SHIFT_LEN

N_BURN_IN      = 30
CANDIDATE_STEP = 1
LAM            = 0.5
ALPHA          = 0.05
N_BOOTSTRAP    = 1000
SAVE_MATRIX_SNAPSHOTS = True

MAX_M_STATISTIC = max(NULL_LEN, SHIFT_LEN)
THRESHOLD_MIN  = N_PRE - N_BURN_IN + 1
THRESHOLD_MAX  = MAX_M_STATISTIC
N_THRESHOLDS   = int((THRESHOLD_MAX - THRESHOLD_MIN) / 5 + 1)

MIN_BLOCK      = 10

CHANGEPOINT_LEARNER_NAMES = [
    "mean_shift",
    ]
CHANGEPOINT_FEATURE_DICT = {
    "identity": ["embedding"],
    "sae":  ["concept"],
    "sae_online": ["concept"],
    "oracle_true": ["concept"],
    "oracle_all8": ["concept"],
    "oracle_random_pool": ["concept"],
    "bertopic_llm": ["concept"],
}

CONCEPT_LEARNER_TYPES = [
    "identity",
    "sae",
    "bertopic_llm",
]
LLM_LEARNER_TYPES = ["bertopic_llm"]
CONCEPT_TYPES = LLM_LEARNER_TYPES + ["oracle_random_pool"]
N_INIT_CONCEPTS           = 4
N_NEW_CONCEPTS_PER_UPDATE = 2
LLM_N_NEW_CONCEPTS        = 2

N_BERTOPIC_TOPICS = 25

SAE_M = 32
SAE_K = 3
SAE_REFIT_EVERY  = 1
SAE_REFIT_EPOCHS = 5

ALL8_CONCEPT_COLS = ["food_mentioned", "food_negative",
                     "ambiance_mentioned", "ambiance_negative",
                     "service_mentioned", "service_negative",
                     "noise_mentioned", "noise_negative"]
ORACLE_RANDOM_POOL_N_NOISE_INDEPENDENT = 2
ORACLE_RANDOM_POOL_N_NOISE_CORRELATED  = 2
ORACLE_RANDOM_POOL_NOISE_P             = 0.3
ORACLE_RANDOM_POOL_FLIP_RATE           = 0.3
ORACLE_RANDOM_POOL_NOISE_COLS = (
    [f"noise_ind_{i}" for i in range(ORACLE_RANDOM_POOL_N_NOISE_INDEPENDENT)]
    + [f"noise_corr_{i}" for i in range(ORACLE_RANDOM_POOL_N_NOISE_CORRELATED)]
)
ORACLE_CONCEPT_SETS = {
    "oracle_all8": ALL8_CONCEPT_COLS,
    "oracle_random_pool": ALL8_CONCEPT_COLS + ORACLE_RANDOM_POOL_NOISE_COLS,
}


def _oracle_concept_cols(concept_learner_type, shift_aspect):
    if concept_learner_type == "oracle_true":
        return [shift_aspect]
    return ORACLE_CONCEPT_SETS[concept_learner_type]

SCL_VARIANT = "subset_scan"


CLASSIFIERS        = [
    "logistic",
]
MAX_UNPENALIZED_DIM = 10

CTM_SCORERS = [
    "cosine_centroid",
    "guided"
]
CTM_N_REFERENCE = K_CALIB // 2
CTM_JUMP_RATES = "0.01"
def _ctm_direction_files(shift_aspect):
    return {
        "text-oracle":    f"prompts/drift_directions_oracle_{shift_aspect}.json",
        "text-unrelated": f"prompts/drift_directions_unrelated_{shift_aspect}.json",
    }
CTM_POOL_VARIANT = "embedding-oracle"

THRESHOLD_MAX_PLOT = THRESHOLD_MAX
THRESHOLD_MAX_PLOT_NULL = MAX_STEPS_NULL - N_BURN_IN
PLOT_HUE_COLS = ["family", "cp_feature_source", "concept_learner_type",
                 "oracle_variant", "sae_variant", "variant", "search_all_sizes"]


def _mirror_outdir(outdir, subdir):
    return (outdir if subdir is None
            else normpath(path_join(OUTDIR, subdir, relpath(outdir, OUTDIR))))


def _seed_class(cap, n_seeds):
    limits = [x for x in (cap, n_seeds) if x is not None]
    return "*" if not limits else f"[0-{min(limits) - 1}]"


def _capped_run_seeds(c):
    caps = SEED_CAPS.get(c["concept_learner_type"])
    if caps is None:
        return list(c["seed_dict"])
    keep = []
    for key in c["seed_dict"]:
        kind = "null" if key.startswith("null_") else "shift"
        if int(key.rsplit("_", 1)[1]) < caps[kind]:
            keep.append(key)
    return keep


def _monitor_seed(run_seed_key):
    assert run_seed_key.startswith(("null_", "shift_")), (
        f"unknown stream family: {run_seed_key}"
    )
    stream_idx = int(run_seed_key.rsplit("_", 1)[1])
    return stream_idx if run_seed_key.startswith("null_") else SHIFT_SEED_OFFSET + stream_idx


nest = SConsWrap(Nest(), OUTDIR, alias_environment=localenv)

if not (File(POPULATION_CSV).exists() and File(POPULATION_EMB).exists()):
    @nest.add_target_with_env(localenv)
    def build_population(env, outdir, c):
        targets = [POPULATION_CSV, POPULATION_EMB, "data/population.log"]
        cmd = [
            "python", "src/assemble_cebab_population.py",
            "--out-population-csv", "${TARGETS[0]}",
            "--out-embeddings-npz", "${TARGETS[1]}",
            "--log",                "${TARGETS[2]}",
        ]
        return env.Command(targets, [], " ".join(map(str, cmd)))

