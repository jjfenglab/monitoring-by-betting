    label_func=lambda c: f"llm_{c.replace('/', '_').replace('.', '_')}")

@nest.add_target_with_env(localenv)
def create_scl_config(env, outdir, c):
    targets = [path_join(outdir, "scl_config.json")]
    sources = []
    n_init_concepts = (N_INIT_CONCEPTS if c["concept_learner_type"] in CONCEPT_TYPES else SAE_M if "sae" in c["concept_learner_type"] else 0)
    n_new = (LLM_N_NEW_CONCEPTS
             if c["concept_learner_type"] in CONCEPT_TYPES
             else N_NEW_CONCEPTS_PER_UPDATE)
    cmd = [
        "python", "src/write_scl_config.py",
        "--out",                       "${TARGETS[0]}",
        "--concept-learner-type",
        ("oracle" if c["concept_learner_type"].startswith("oracle")
         else "sae" if _is_sae(c)
         else c["concept_learner_type"]),
        "--scl-variant",               SCL_VARIANT,
        "--n-burn-in",                 N_BURN_IN,
        "--seed",                      12345,
        "--n-init-concepts",           n_init_concepts,
        "--n-new-concepts-per-update", n_new,
        "--max-unpenalized-dim",       MAX_UNPENALIZED_DIM,
        "--cache-mode",                "per_stream",
        "--classifier-type",          c["classifier"],
    ]

    if c["search_all_sizes"]:
        cmd.append("--search-all-sizes")

    if _is_sae(c):
        sources = [c["train_sae"][0], c["assemble_pools"][2], c["assemble_pools"][3]]
        cmd += [
            "--sae-checkpoint-path", "${SOURCES[0]}",
            "--sae-embeddings-path", "${SOURCES[1]}",
            "--sae-mapping-path",    "${SOURCES[2]}",
        ]
        if c["concept_learner_type"] == "sae_online":
            sources.append(c["assemble_pools"][5])
            cmd += [
                "--sae-refit-every",         SAE_REFIT_EVERY,
                "--sae-refit-epochs",        SAE_REFIT_EPOCHS,
                "--sae-side-embeddings-path", "${SOURCES[3]}",
            ]
    elif c["concept_learner_type"].startswith("oracle"):
        if c["concept_learner_type"] in ("oracle_random_pool", "oracle_all8"):
            sources = [c["augment_oracle_random_pool"][0],
                       c["augment_oracle_random_pool"][1]]
        else:
            sources = c["assemble_pools"][:2]
        cmd += [
            "--oracle-pool-csvs",    "${SOURCES[0]}", "${SOURCES[1]}",
            "--oracle-concept-cols", *_oracle_concept_cols(c["concept_learner_type"], c["shift_aspect"]),
            "--oracle-variant",      c["concept_learner_type"],
        ]
        if c["concept_learner_type"] == "oracle_random_pool":
            cmd += [
                "--oracle-proposal-mode",    "random_pool",
                "--oracle-informative-cols", *_oracle_concept_cols("oracle_true", c["shift_aspect"]),
            ]
    elif c["concept_learner_type"] == "bertopic_llm":
        cmd += [
            "--llm-keyphrase-model", c["llm_model"],
            "--prompt-keyphrase-file", PROMPT_KEYPHRASE_FILE,
            "--keyphrase-batch-size", LLM_BATCH_SIZE,
            "--llm-proposer-model", c["llm_model"],
            "--prompt-proposer-iter-file", PROMPT_BERTOPIC_ITER_FILE,
            "--prompt-proposer-init-file", PROMPT_BERTOPIC_INIT_FILE,
            "--n-bertopic-topics", N_BERTOPIC_TOPICS,
            "--llm-annotator-model", c["llm_model"],
            "--prompt-annotator-file", PROMPT_ANNOTATOR_FILE,
            "--annotator-batch-size", LLM_BATCH_SIZE,
            "--single-concept-mode" if c["single_concept"] else "",
        ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))

nest.add_aggregate("result_pkls", list)
nest.add("run_seed", _capped_run_seeds)

@nest.add_target_with_env(localenv)
def run_monitor(env, outdir, c):
    sources = [
        c["assemble_pools"][2],
        c["seed_dict"][c["run_seed"]],
        c["create_scl_config"][0],
    ]
    targets = [
        path_join(outdir, "result_whiten.pkl"),
        path_join(outdir, "run_whiten.log"),
        path_join(outdir, "debug_whiten.csv"),
        path_join(outdir, "concept_episodes_whiten.csv"),
    ]
    cmd = [
        "python", "src/run_monitor.py",
        "--scl-config",          "${SOURCES[2]}",
        "--changepoint-learner", c["changepoint_learner"],
        "--cp-feature-source",   c["cp_feature_source"],
        "--seed",                _monitor_seed(c["run_seed"]),
        "--lam",                 LAM,
        "--alpha",               ALPHA,
        "--max-m-statistic",     MAX_M_STATISTIC if c["concept_learner_type"] == "bertopic_llm" else (MAX_M_STATISTIC * 3),
        "--candidate-step",      CANDIDATE_STEP,
        "--min-block",           MIN_BLOCK,
        "--embeddings-path",     "${SOURCES[0]}",
        "--stream-csv",          "${SOURCES[1]}",
        "--out",                 "${TARGETS[0]}",
        "--log",                 "${TARGETS[1]}",
        "--debug-csv",           "${TARGETS[2]}",
        "--concept-episodes-csv", "${TARGETS[3]}",
    ]
    save_keyphrases = c["concept_learner_type"] in LLM_LEARNER_TYPES
    if save_keyphrases:
        targets.append(path_join(outdir, "keyphrase_outputs.csv"))
        cmd += ["--keyphrase-csv ${TARGETS[4]}"]
    
    if c["concept_learner_type"] == "sae_online":
        targets.append(path_join(outdir, "sae_final.pt"))
        cmd += ["--sae-final-checkpoint", f"${{TARGETS[{len(targets) - 1}]}}"]

    stream_cache = path_join(dirname(c["seed_dict"][c["run_seed"]]), "cache.db")
    if c["concept_learner_type"] in LLM_LEARNER_TYPES:
        sources = sources + PROMPT_SOURCES
        cmd += ["--cache-file", path_join("exp_cebab", stream_cache)]

    c["result_pkls"].append(targets[0])
    if c["run_seed"].startswith("shift_"):
        if c["concept_learner_type"] == "bertopic_llm":
            c["bertopic_llm_debug_csvs"][c["run_seed"]] = targets[2]
        elif c["concept_learner_type"] == "identity":
            c["identity_debug_csvs"][c["run_seed"]] = targets[2]
    result = env.Command(targets, sources, _run_cmd(cmd, n_cpus=2))
    if c["concept_learner_type"] in LLM_LEARNER_TYPES:
        env.SideEffect(stream_cache, result)
    return result

@nest.add_target_with_env(localenv)
def plot_e_statistic(env, outdir, c):
    sources = [c["run_monitor"][2]]
    targets = [
        path_join(outdir, "e_statistic.png"),
        path_join(outdir, "plot_e_statistic.log"),
    ]
    if int(c["run_seed"].split("_")[-1]) < 2:
        cmd = [
            "python", "src/plot_e_statistic.py",
            "--debug-csv", "${SOURCES[0]}",
            "--fig-path",  "${TARGETS[0]}",
            "--log",       "${TARGETS[1]}",
        ]
        return env.Command(targets, sources, _run_cmd(cmd))

nest.pop("run_seed")

@nest.add_target_with_env(localenv)
def concept_prevalence(env, outdir, c):
    if c["concept_learner_type"] != "bertopic_llm":
        return None
    caps = SEED_CAPS.get(c["concept_learner_type"])
    shift_pat = f"seed_{_seed_class(caps and caps['shift'], None)}"
    shift_res_globs = []
    for pkl_path in c["result_pkls"]:
        if "seed_0" in pkl_path and "null" not in pkl_path:
            shift_res_globs.append(path_join("exp_cebab", pkl_path.replace("seed_0", shift_pat)))
    if not shift_res_globs:
        return None
    sources = c["result_pkls"]
    targets = [
        path_join(outdir, "concept_prevalence.csv"),
        path_join(outdir, "concept_prevalence.log"),
    ]
    cmd = [
        "python", "src/aggregate_concept_prevalence.py",
        "--result-glob", " ".join([f'"{gl}"' for gl in shift_res_globs]),
        "--changepoint", N_PRE,
        "--out-csv",     "${TARGETS[0]}",
        "--log",         "${TARGETS[1]}",
    ]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


@nest.add_target_with_env(localenv)
def cell_summary(env, outdir, c):
    caps = SEED_CAPS.get(c["concept_learner_type"])
    skip_null = (N_NULL_SEEDS == 0) or (caps and caps["null"] == 0)
    nodes = []
    result_pkls = c["result_pkls"]
    shift_pat = f"seed_{_seed_class(caps and caps['shift'], None)}"
    null_metas, null_res_glob, null_dat_glob = [], None, None
    if not skip_null:
        null_class = _seed_class(caps and caps["null"], None)
        null_pat = f"null_{null_class}"
        null_meta_pat = f"{c['shift_aspect']}/null/seed_{null_class}"
        null_metas = [c["seed_dict"][k].replace("stream.csv", "stream_metadata.json")
                        for k in c["seed_dict"] if k.startswith("null_")]
        null_dat_glob = path_join("exp_cebab", OUTDIR, null_meta_pat,
                                    "stream_metadata.json")
    sources = ([c["create_scl_config"][0]] + result_pkls + c["metadata_list"]
                + null_metas)
    shift_res_globs = []
    for pkl_path in result_pkls:
        if "null_0" in pkl_path:
            null_res_glob = path_join("exp_cebab", pkl_path.replace("null_0", null_pat))
        elif "seed_0" in pkl_path:
            shift_res_globs.append(path_join("exp_cebab", pkl_path.replace("seed_0", shift_pat)))
    shift_dat_globs = []
    for metadata_path in c["metadata_list"]:
        if "seed_0" in metadata_path:
            shift_dat_globs.append(path_join("exp_cebab", metadata_path.replace("seed_0", shift_pat)))
    targets = [
        path_join(outdir, "summary.csv"),
        path_join(outdir, "aggregate.log"),
    ]
    cmd = [
        "python", "src/aggregate_cell.py",
        "--shift-res-globs",        " ".join([f'"{gl}"' for gl in shift_res_globs]),
        "--shift-dat-globs",        " ".join([f'"{gl}"' for gl in shift_dat_globs]),
        "--label",                 c["shift_aspect"],
        "--threshold-min",         THRESHOLD_MIN,
        "--threshold-max",         THRESHOLD_MAX,
        "--n-thresholds",          N_THRESHOLDS,
        "--n-bootstrap",           N_BOOTSTRAP,
        "--config-json",           "${SOURCES[0]}",
        "--e-process",             "ProposedMethod",
        "--changepoint-learner",   c["changepoint_learner"],
        "--cp-feature-source",     c["cp_feature_source"],
        "--k-calib",               K_CALIB,
        "--out-csv",               "${TARGETS[0]}",
        "--log",                   "${TARGETS[1]}",
    ]
    cmd += (["--skip-null"] if skip_null
            else ["--null-res-glob", f'"{null_res_glob}"',
                    "--null-dat-glob", f'"{null_dat_glob}"'])
    c["cell_summaries"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("changepoint_learner")


def _ensemble_seeds(c):
    if "bertopic_llm" in CONCEPT_LEARNER_TYPES:
        return sorted(set(c["bertopic_llm_debug_csvs"]) & set(c["identity_debug_csvs"]))
    else:
        return []


ENSEMBLE_COMBINE = {
    "ensemble_m": "m_statistic"
}
nest.add("ensemble", list(ENSEMBLE_COMBINE), label_func=lambda c: c)


@nest.add_target_with_env(localenv)
def create_ensemble_config(env, outdir, c):
    targets = [path_join(outdir, "ensemble_config.json")]
    cmd = [
        "python", "src/write_ensemble_config.py",
        "--out",        "${TARGETS[0]}",
        "--n-burn-in",  N_BURN_IN,
        "--concept-learner-type", c["ensemble"],
    ]
    return env.Command(targets, [], _run_cmd(cmd, use_slurm=False))


nest.add_aggregate("ensemble_result_pkls", list)
nest.add("ensemble_seed", _ensemble_seeds, label_func=lambda c: c)


@nest.add_target_with_env(localenv)
def run_ensemble_monitor(env, outdir, c):
    bertopic_debug = c["bertopic_llm_debug_csvs"][c["ensemble_seed"]]
    identity_debug = c["identity_debug_csvs"][c["ensemble_seed"]]
    sources = [bertopic_debug, identity_debug]
    targets = [
        path_join(outdir, "result.pkl"),
        path_join(outdir, "run.log"),
        path_join(outdir, "debug.csv"),
    ]
    cmd = [
        "python", "src/run_ensemble_monitor.py",
        "--debug-csv-1",     "${SOURCES[0]}",
        "--debug-csv-2",     "${SOURCES[1]}",
        "--combine",         ENSEMBLE_COMBINE[c["ensemble"]],
        "--lam",             LAM,
        "--max-m-statistic", MAX_M_STATISTIC,
        "--stream-length",   SHIFT_LEN,
        "--out-pkl",         "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
        "--out-debug-csv",   "${TARGETS[2]}",
    ]
    c["ensemble_result_pkls"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("ensemble_seed")


@nest.add_target_with_env(localenv)
def ensemble_cell_summary(env, outdir, c):
    if len(c["ensemble_result_pkls"]) == 0:
        return
    sources = [c["create_ensemble_config"][0]] + c["ensemble_result_pkls"]
    shift_res_glob = path_join(
        "exp_cebab", OUTDIR,
        c["shift_aspect"],
        c["ensemble"],
        "shift_*_seed_*",
        "result.pkl",
    )
    shift_dat_glob = path_join(
        "exp_cebab", OUTDIR,
        c["shift_aspect"],
        "post_p1_*",
        "seed_*",
        "stream_metadata.json",
    )
    targets = [
        path_join(outdir, "summary.csv"),
        path_join(outdir, "aggregate.log"),
    ]
    cmd = [
        "python", "src/aggregate_cell.py",
        "--shift-res-globs",      f'"{shift_res_glob}"',
        "--shift-dat-globs",      f'"{shift_dat_glob}"',
        "--skip-null",
        "--label",                c["shift_aspect"],
        "--threshold-min",        THRESHOLD_MIN,
        "--threshold-max",        THRESHOLD_MAX,
        "--n-thresholds",         N_THRESHOLDS,
        "--n-bootstrap",          N_BOOTSTRAP,
        "--config-json",          "${SOURCES[0]}",
        "--e-process",            "ProposedMethod",
        "--changepoint-learner",  "mean_shift",
        "--cp-feature-source",    "concept",
        "--k-calib",              K_CALIB,
        "--out-csv",              "${TARGETS[0]}",
        "--log",                  "${TARGETS[1]}",
    ]
    c["cell_summaries"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.pop("ensemble")


nest.add("ctm_scorer", CTM_SCORERS, label_func=lambda c: f"ctm_{c}")
nest.add("ctm_variant",
         lambda c: list(_ctm_direction_files(c["shift_aspect"])) + [CTM_POOL_VARIANT]
         if c["ctm_scorer"] == "guided" else ["none"],
         label_func=lambda c: f"var_{c}")


@nest.add_target_with_env(localenv)
def create_ctm_config(env, outdir, c):
    targets = [path_join(outdir, "ctm_config.json")]
    sources = []
    cmd = [
        "python", "src/write_ctm_config.py",
        "--out",          "${TARGETS[0]}",
        "--scorer",       c["ctm_scorer"],
        "--n-reference",  CTM_N_REFERENCE,
        "--jump-rates",   CTM_JUMP_RATES,
        "--alpha",        ALPHA,
        "--n-burn-in",    N_BURN_IN,
    ]
    if c["ctm_scorer"] == "guided":
        if c["ctm_variant"] == CTM_POOL_VARIANT:
            sources = [c["write_pool_direction"][0]]
        else:
            sources = [c["write_text_direction"][c["ctm_variant"]][0]]
        cmd += ["--direction-path", "${SOURCES[0]}",
                "--variant",        c["ctm_variant"]]
    return env.Command(targets, sources, _run_cmd(cmd, use_slurm=False))


nest.add_aggregate("ctm_result_pkls", list)
nest.add("run_seed", lambda c: c["seed_dict"].keys())


@nest.add_target_with_env(localenv)
def run_ctm_monitor(env, outdir, c):
    sources = [
        c["assemble_pools"][2],
        c["seed_dict"][c["run_seed"]],
        c["create_ctm_config"][0],
    ]
    targets = [
        path_join(outdir, "result.pkl"),
        path_join(outdir, "run.log"),
        path_join(outdir, "debug.csv"),
    ]
    cmd = [
        "python", "src/run_ctm_monitor.py",
        "--ctm-config",      "${SOURCES[2]}",
        "--stream-csv",      "${SOURCES[1]}",
        "--embeddings-path", "${SOURCES[0]}",
        "--seed",            _monitor_seed(c["run_seed"]),
        "--max-m-statistic", MAX_M_STATISTIC,
        "--out",             "${TARGETS[0]}",
        "--log",             "${TARGETS[1]}",
        "--debug-csv",       "${TARGETS[2]}",
    ]
    c["ctm_result_pkls"].append(targets[0])
    return env.Command(targets, sources, _run_cmd(cmd))


